---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { CATEGORIES } from '../../content.config';

export const getStaticPaths = (async () => {
  return CATEGORIES.map((c) => ({ params: { cat: c.id }, props: { meta: c } }));
}) satisfies GetStaticPaths;

const { meta } = Astro.props;

const items = (
  await getCollection('cases', ({ data }) => !data.draft && data.category === meta.id)
).sort((a, b) => b.data.weight - a.data.weight);

const others = CATEGORIES.filter((c) => c.id !== meta.id);
---

<Base title={`${meta.label} — 박근민`} description={meta.blurb}>
  <header class="head">
    <div class="wrap">
      <nav class="crumb" aria-label="위치">
        <a href="/">사례 전체</a>
        <span aria-hidden="true">/</span>
        <span>{meta.label}</span>
      </nav>
      <p class="eyebrow">{meta.en}</p>
      <h1>{meta.label}</h1>
      <p class="lede">{meta.blurb}</p>
      <p class="count">{items.length}건</p>
    </div>
  </header>

  <section class="tight">
    <div class="wrap">
      {
        items.length > 0 ? (
          <div class="grid">
            {items.map((entry) => (
              <CaseCard entry={entry} variant="tile" />
            ))}
          </div>
        ) : (
          <p class="empty">
            이 층에 공개된 사례가 아직 없습니다. 원천 자료는 쌓여 있고, 정리되는 대로 올라옵니다.
          </p>
        )
      }
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <p class="jump-label">다른 층</p>
      <div class="jump">
        {others.map((c) => <a href={`/category/${c.id}/`}>{c.label}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .head { padding: 64px 0 40px; }
  .crumb {
    display: flex;
    gap: 9px;
    font-size: 13px;
    color: var(--ink-faint);
    margin-bottom: 26px;
  }
  .crumb a { color: var(--ink-dim); text-decoration: none; }
  .crumb a:hover { color: var(--accent); }

  h1 {
    font-size: clamp(28px, 4.4vw, 44px);
    margin: 14px 0 18px;
  }
  .count {
    margin-top: 20px;
    font-family: var(--serif);
    font-size: 14px;
    color: var(--accent2);
    letter-spacing: .06em;
    font-variant-numeric: tabular-nums;
  }

  /* 카테고리 페이지는 아카이브 성격이라 격자가 맞다 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 14px;
  }

  .empty {
    color: var(--ink-faint);
    font-size: 15px;
    padding: 40px 0;
    border-top: 1px solid var(--rule);
  }

  .jump-label {
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 14px;
  }
  .jump { display: flex; flex-wrap: wrap; gap: 9px; }
  .jump a {
    font-size: 13.5px;
    color: var(--ink-dim);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 7px 15px;
    border-radius: 99px;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast);
  }
  .jump a:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .head { padding: 44px 0 30px; }
  }
</style>
