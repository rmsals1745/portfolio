---
/**
 * 첫 화면 — 확정 시안 3-B (docs/refs/2026-09-25-시안3B-색면표지.html)
 * 초록 색면 표지 → 왼쪽 고정 칸 + 대표 4개 타임라인(제자리 펼침) → 나머지 목록 → 연락.
 * 케이스의 제목·기간·스택·링크는 콘텐츠 컬렉션에서 읽고, 컬렉션에 없는 서술(문제·지은 것·결과·구조)만 여기 둔다.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('cases', ({ data }) => !data.draft);
const byId = Object.fromEntries(all.map((c) => [c.id, c]));

const EMAIL = 'rmsals1745@gmail.com';

/** 기간 표기 — 「2026.04 –」 → 「2026.04 — 지금」 */
const span = (period: string) => period.replace(/\s*[–-]\s*$/, ' — 지금');

/** 대표 4개. 서술은 시안 문구 및 spec 기준. */
const featured = [
  {
    id: 'justswarm', anchor: 'swarm', toc: 'justswarm', title: 'justswarm',
    sub: 'AI 여러 대를 한 팀으로 묶는 엔진', who: '설계·구현 단독',
    thumbType: 'svg-swarm',
    thumbAlt: 'justswarm 흐름 — 워커 → diff → 게이트 → 검수자 → 승인 및 되돌림 회귀 화살표',
    problem: 'AI가 낸 결과는 그럴듯하게 틀립니다. 같은 AI가 만들고 같은 AI가 검사하면 그냥 통과합니다.',
    built: '한 AI가 코드를 짜면 다른 회사의 AI가 검사하고, 통과할 때까지 되돌려 보내는 엔진. 자기 결과를 스스로 통과시키는 길을 구조적으로 막았습니다.',
    result: '52번 실행 중 17번에서 검사 AI가 실제로 고치라고 돌려보냈습니다 — 검사가 장식이 아니라는 뜻입니다.',
    blocks: [
      { h: '구조', list: [
        ['만드는 AI와 검사하는 AI를 다른 회사 모델로 분리', '판정은 approve · revise · reject 세 단어만 받습니다. 형식을 안 지키면 엔진이 다시 묻습니다.'],
        ['셀프리뷰 차단', '그 판에서 결과물을 낸 모델은 검사 후보에서 자동으로 빠집니다. 후보가 다 떨어지면 자동 승인 대신 사람에게 넘깁니다.'],
        ['한 곳이 죽어도 안 멈추는 대체 순번', '장애 · 안전필터 거부 · 글자 깨짐을 서로 다른 실패로 나눠 다음 모델로 넘깁니다.'],
        ['AI의 자기 보고는 믿지 않습니다', '실제로 바뀐 코드(diff)만 판정에 씁니다.'],
      ] },
      { h: '검사가 잡아낸 것', p: '셀프리뷰 가드를 넣기 전엔 검사자 없이 승인된 실행이 2번 있었습니다. 가드를 넣은 뒤 103번 실행에서는 한 번도 없었습니다. 또 "타입 검사 통과" 같은 신호는 AI가 아무 일도 안 해도 통과한다는 걸 발견해, 작업 전 상태에서도 통과하는 검사를 가려내는 장치를 넣었습니다.' },
    ],
  },
  {
    id: 'inlifeclick', anchor: 'inlife', toc: '인생딸깍', title: '인생딸깍',
    sub: 'AI가 블로그·SNS 글을 대신 써주는 월 구독 서비스', who: '기획부터 배포까지 단독',
    thumbType: 'image',
    thumbSrc: '/shots/inlife-alley.jpg',
    thumbAlt: '인생딸깍 골목 — 딸깍판다와 5채의 가게들',
    problem: '홍보 글은 누구에게나 필요하지만, 매번 쓸 시간과 요령이 없습니다. 무엇을 써야 할지부터 막힙니다.',
    built: 'AI가 먼저 인터뷰로 이야기를 캐낸 뒤 글을 쓰고 네이버 블로그 발행까지 잇는 서비스. 결제 · 환불 · 약관 · 사업자 요건까지 혼자 갖췄습니다.',
    result: '첫 줄을 쓴 지 4개월 만에 실제로 돈을 받는 서비스가 됐고, 운영을 멈추지 않은 채 데이터베이스 구조를 40번 고쳤습니다.',
    blocks: [
      { h: '어떻게 돌아가나', list: [
        ['설문지 대신 인터뷰', '마스코트 「딸깍판다」가 마주 앉아 묻고, 옆 칠판에 상담 진행률과 "꼭 필요한 것 / 있으면 좋은 것"이 채워집니다.'],
        ['질문은 전부 객관식 카드', '"손님이 주로 어디서 오세요?" 같은 답에 따라 글의 전략이 갈립니다.'],
        ['하나의 씨앗에서 여러 채널', '블로그는 발행까지, 인스타그램 · 쓰레드 · X 는 원고를 만들어 작성창까지 실어 보냅니다. 올리는 손가락은 사용자 것으로 남겼습니다.'],
      ] },
      { h: '결제 안전망', p: '결제사 서명 검증 · 단건 재조회 · 중복 지급 방지, 세 겹으로 이중결제와 누락을 막습니다. 요금제는 월 구독 하나입니다.' },
    ],
  },
  {
    id: 'justgraph', anchor: 'graph', toc: 'justgraph', title: 'justgraph',
    sub: '혼자 만든 시스템이 어디 살고 무엇과 이어져 있는지 보여주는 동네 지도', who: '설계·구현 단독',
    thumbType: 'image',
    thumbSrc: '/shots/justgraph-map.jpg',
    thumbAlt: 'justgraph 동네 지도 — 앱 거리·일꾼 공장·서버 등대·작업대·기억 도서관·곳간이 동사가 붙은 길로 이어져 있다',
    problem: '혼자 만든 자산이 수십 개를 넘자, 만든 사람도 무엇이 무엇을 부르는지 기억하지 못하게 됐습니다. 고장이 나면 어디부터 봐야 할지 모르는 게 위험이었습니다.',
    built: '자산 장부를 읽어 동네(앱 거리·일꾼 공장·서버 등대·곳간)로 나누고 건물 사이 길에 「일을 맡긴다」「매일 복제된다」처럼 동사를 붙여 한눈에 보이게 한 지도.',
    result: '8월에 마케팅 도구로 잘못 지었던 첫 구현을 버리고, 시스템 전체를 한눈에 관측하고 복구 방법을 배우는 진짜 지도로 다시 세웠습니다.',
    blocks: [
      { h: '동네로 나누는 시스템', list: [
        ['역할별 구역 분리', '화면으로 여는 것(앱 거리), 뒤에서 일하는 것(일꾼 공장), 밤에도 켜져 있는 것(서버 등대), 날아가도 되찾게 해 주는 것(곳간).'],
        ['동사가 붙은 연결 길', '단순 선 연결이 아니라 「일을 맡긴다」「매일 복제된다」처럼 무엇이 무엇에게 무엇을 하는지 관계를 명시합니다.'],
        ['자산 장부 자동 연동', '코드와 인프라의 실제 자산 장부(JSON)를 파싱해 지도를 구성합니다.'],
      ] },
      { h: '한 번 틀리고 다시 지었습니다', p: '8월에 처음 지은 justgraph 는 이름만 보고 마케팅 자동화 그래프로 만들었습니다. 한 달 뒤 목적이 「내 시스템을 이해하는 지도」였다는 걸 확인하고, 그 구현을 버리고 처음부터 다시 설계했습니다. 다음 단계는 건물을 누르면 그 자산의 복구 방법을 배우는 퀘스트입니다.' },
    ],
  },
  {
    id: 'hermes-runtime', anchor: 'hermes', toc: 'Hermes 런타임', title: 'Hermes 상시 런타임',
    sub: 'PC가 꺼져 있어도 예약한 일이 굴러가는 바닥', who: '설계·구현 단독',
    thumbType: 'svg-hermes',
    thumbAlt: 'Hermes 상시 런타임 — PC 꺼짐에도 서버 시계가 일을 깨운다 (시계 + 서버 + 결재 대기 → 재개)',
    problem: '작업 PC는 대부분 꺼져 있습니다. 시간 맞춰 도는 자동화는 기계가 꺼진 동안 조용히 건너뛰고, 아무도 모릅니다.',
    built: '에이전트가 필요 없는 반복 작업 14개를 중앙에서 떼어 OS 스케줄러로 내리고, 원격 서버에 상주 워커를 두고, 백업을 세 곳에 나눴습니다.',
    result: '중앙이 죽거나 PC가 꺼져 있어도 각자 돌고, 놓친 일은 기계가 켜지는 순간 따라잡습니다.',
    blocks: [
      { h: '구조', list: [
        ['중앙과 스케줄 분리', '놓친 실행을 켜지는 순간 다시 도는 설정으로, 중앙 재시작 · 크래시와 무관하게 굴러갑니다.'],
        ['이벤트 훅', '세션 시작 때 작업 맥락 주입과 자동 저장, 끝날 때 배운 개념 추출. 사람이 기억할 일을 런타임이 대신 기억합니다.'],
        ['원격 상주', '메신저 → 서버 에이전트 → 코드 반영 → 결재가 PC 없이 진행됩니다.'],
        ['백업 세 곳', '로컬 · GitHub · 클라우드.'],
      ] },
      { h: '알아낸 것', p: 'AI 서비스가 결제 오류를 낼 때 "충전이 부족한가" 싶어 시간을 버렸는데, 실제 원인은 프로필마다 흩어진 설정에 남은 옛 주소였습니다. 그 뒤로 키를 한 곳에만 두게 다시 설계했습니다.' },
    ],
  },
].map((f) => {
  const c = byId[f.id];
  return {
    ...f,
    when: c ? `${span(c.data.period)} · ${f.who}` : f.who,
    stack: c ? c.data.stack.join(' · ') : '',
    href: c ? `/work/${c.id}/` : undefined,
  };
});

/** 나머지 7개 — 시안의 요약 문구, 순서 그대로. 기간·링크는 컬렉션에서. */
const restRows: [string, string, string][] = [
  ['justlink', 'justlink', '에이전트가 지금 무슨 일을 하는지 한 화면에서 보고, 맡기고, 결재하는 관제판.'],
  ['execution-visibility', '실행 가시성 계층', 'AI가 몇 초째 무엇을 부르는지, 지금까지 얼마를 썼는지 화면 아래에 늘 띄워 둡니다.'],
  ['just-design', 'JUST DESIGN', '상담지 한 장으로 시안 3개를 병렬 제작하고 기계로 대조해 합격을 가리는 홈페이지 공장.'],
  ['devtutor', 'devtutor', '작업 대화에서 배운 개념을 세션이 끝날 때 뽑아 지식 카드로 쌓습니다.'],
  ['juststandby', 'juststandby', '처음 보는 컴퓨터에서 명령 한 줄로 개발 환경 전체를 되살립니다. 비밀키는 암호화.'],
  ['compliance-plugins', '규제 사전점검 플러그인', '쇼핑몰 · 의료 광고 문구가 법에 걸리는지 올리기 전에 잡습니다. 회귀 시험 56개 전부 통과.'],
  ['local-diffusion-assets', '로컬 이미지 생성 파이프라인', '시안에 들어갈 사진을 외부 서비스 없이 내 컴퓨터에서 직접 만듭니다.'],
];
const rest = restRows.map(([id, title, text]) => ({
  title, text,
  time: byId[id]?.data.period.replace(/\s*–\s*$/, ' —') ?? '',
  href: byId[id] ? `/work/${id}/` : undefined,
}));

const total = featured.length + rest.length;
const mail = (subject: string) => `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}`;
---

<Base
  bare
  title="박근민 — AI 에이전트 시스템 엔지니어"
  description="여러 AI를 한 팀으로 묶고, 서로 검사하게 만들고, 사람이 없어도 돌아가게 합니다. 설계부터 운영까지 혼자 합니다."
>
  <meta slot="head" name="keywords" content="justgraph, justswarm, inlife, hermes" />
  <header class="cover" id="top">
    <div class="cover-top">
      <b>박근민 <span class="en">Justin Avery Park</span></b>
      <nav aria-label="바로가기">
        <a href="#work">작업</a>
        <a href="#rest">나머지</a>
        <a href="#contact">연락</a>
      </nav>
    </div>

    <svg class="ring" viewBox="0 0 600 600" aria-hidden="true">
      <circle cx="300" cy="300" r="250" fill="none" stroke="#2b4f46" stroke-width="64"></circle>
      <circle cx="300" cy="300" r="150" fill="none" stroke="#2b4f46" stroke-width="18"></circle>
      <path d="M300 50 A250 250 0 0 1 550 300" fill="none" stroke="#b8955c" stroke-width="64"></path>
    </svg>

    <h1 class="statement">
      <span>AI가 일하는</span>
      <span class="indent">판을 <em>혼자</em> 짓고</span>
      <span>꺼지지 않게</span>
      <span class="indent">굴립니다.</span>
    </h1>
    <div class="rule" aria-hidden="true"></div>

    <div class="cover-foot">
      <div class="mobile-portrait-box">
        <img class="profile-photo" src="/me/portrait.jpg" alt="박근민" width="112" height="112" loading="eager" />
      </div>
      <p class="who-line"><strong>AI 에이전트 시스템 · 인프라 엔지니어.</strong> 여러 AI를 한 팀으로 묶고, 서로 검사하게 만들고, 사람이 없어도 돌아가게 합니다. 설계부터 운영까지 혼자 합니다.</p>
      <div class="cover-cta">
        <a class="btn btn-brass" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="btn btn-ghost" href="#work">대표 작업 {featured.length}개 보기 ↓</a>
      </div>
    </div>
  </header>

  <div class="split">
    <aside class="side" aria-label="요약">
      <div class="side-profile">
        <img class="profile-photo" src="/me/portrait.jpg" alt="박근민" width="116" height="116" loading="eager" />
      </div>
      <h2><small>Who</small>박근민<br />AI 에이전트 · 인프라</h2>
      <p class="lead">에이전트를 한 번 돌려보는 것과, 매일 그 위에서 일이 굴러가게 만드는 것은 다른 문제입니다. 저는 뒤쪽을 합니다.</p>

      <div>
        <p class="label">이런 자리에 맞습니다</p>
        <ul class="hire">
          <li>Forward Deployed Engineer<span>고객 현장에 들어가 요구를 캐내고 바로 짓는 자리</span></li>
          <li>Solutions Architect<span>여러 모델·서비스를 묶는 구조를 그리는 자리</span></li>
          <li>AI 인프라 엔지니어링<span>에이전트가 안 멈추고, 안 속고, 비용이 보이게</span></li>
        </ul>
      </div>

      <div class="side-contact">
        <p class="label">연락</p>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href="https://github.com/rmsals1745" target="_blank" rel="noopener">github.com/rmsals1745 ↗</a>
      </div>

      <nav class="toc" aria-label="섹션">
        {featured.map((f, i) => <a href={`#${f.anchor}`}><i>{String(i + 1).padStart(2, '0')}</i>{f.toc}</a>)}
        <a href="#rest"><i>+{rest.length}</i>나머지 작업</a>
        <a href="#contact"><i>→</i>연락하기</a>
      </nav>
    </aside>

    <div class="main" id="work">
      <p class="intro">2026년 4월부터 만든 시스템 {total}개 중 <mark>지금도 매일 돌아가는 대표 {featured.length}개</mark>입니다. 각각 어떤 문제였고, 무엇을 지었고, 그래서 무엇이 달라졌는지만 적었습니다. 누르면 자세히 펼쳐집니다.</p>

      <div class="timeline">
        {featured.map((f) => (
          <article class="case" id={f.anchor}>
            <div class="case-header">
              <div class="case-meta">
                <p class="when">{f.when}</p>
                <h3>{f.title}<small>{f.sub}</small></h3>
              </div>
              <div class="case-thumb">
                {f.thumbType === 'image' && (
                  <img src={f.thumbSrc} alt={f.thumbAlt} class="thumb-media" loading="lazy" />
                )}
                {f.thumbType === 'svg-swarm' && (
                  <svg class="thumb-media thumb-svg" viewBox="0 0 240 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={f.thumbAlt}>
                    <title>{f.thumbAlt}</title>
                    <rect width="240" height="150" fill="#efe8da" />
                    <!-- Nodes: 워커, diff, 게이트, 검수자 -->
                    <!-- 워커 -->
                    <rect x="14" y="24" width="46" height="30" rx="3" fill="#1f3d36" />
                    <text x="37" y="43" fill="#efe8da" font-size="11" font-weight="700" font-family="var(--sans)" text-anchor="middle">워커</text>
                    <!-- 화살표 1 -->
                    <path d="M60 39 H72" stroke="#b8955c" stroke-width="2" stroke-linecap="round" />
                    <path d="M70 36 L74 39 L70 42" stroke="#b8955c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <!-- diff -->
