                    <text x="207" y="43" fill="#efe8da" font-size="11" font-weight="700" font-family="var(--sans)" text-anchor="middle">검수자</text>
                    
                    <!-- 아래 갈림길: 승인(오른쪽 아래) / 되돌림(워커로 회귀 화살표) -->
                    <!-- 승인 라인 -->
                    <path d="M207 54 V88" stroke="#3f7a52" stroke-width="2" stroke-linecap="round" />
                    <path d="M204 86 L207 90 L210 86" stroke="#3f7a52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="188" y="92" width="38" height="24" rx="3" fill="#3f7a52" />
                    <text x="207" y="108" fill="#ffffff" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">승인</text>
                    
                    <!-- 되돌림 회귀 라인 -->
                    <path d="M198 54 V72 C198 78 194 82 188 82 H45 C39 82 35 78 35 72 V58" stroke="#b8955c" stroke-width="1.8" stroke-dasharray="3 2" fill="none" />
                    <path d="M32 60 L35 56 L38 60" stroke="#b8955c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="88" y="74" width="54" height="18" rx="2" fill="#efe8da" />
                    <text x="115" y="87" fill="#8a6a35" font-size="9.5" font-weight="700" font-family="var(--sans)" text-anchor="middle">되돌림 (재작업)</text>
                    
                    <!-- 가이드 텍스트 -->
                    <text x="120" y="132" fill="#52645e" font-size="9" font-family="var(--sans)" text-anchor="middle">셀프리뷰 차단 · diff 기반 상호 검증</text>
                  </svg>
                )}
                {f.thumbType === 'svg-hermes' && (
                  <svg class="thumb-media thumb-svg" viewBox="0 0 240 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={f.thumbAlt}>
                    <title>{f.thumbAlt}</title>
                    <rect width="240" height="150" fill="#efe8da" />
                    <!-- 상단: PC 꺼짐 상태 -->
                    <rect x="16" y="20" width="70" height="34" rx="3" fill="#e6dece" stroke="#d5cbb6" stroke-width="1" />
                    <text x="51" y="36" fill="#67766f" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">PC 꺼짐</text>
                    <text x="51" y="48" fill="#8a6a35" font-size="8.5" font-family="var(--mono)" text-anchor="middle">(대부분 꺼져있음)</text>

                    <!-- 중앙: 서버 시계 & 원격 서버 상주 -->
                    <!-- 시계 아이콘/원 -->
                    <circle cx="120" cy="37" r="14" fill="#2b4f46" stroke="#b8955c" stroke-width="1.5" />
                    <path d="M120 29 V37 H126" stroke="#d9c29a" stroke-width="1.8" stroke-linecap="round" />
                    <text x="120" y="62" fill="#1c302b" font-size="9.5" font-weight="700" font-family="var(--sans)" text-anchor="middle">서버 시계</text>
                    
                    <!-- 서버 상주 워커 -->
                    <rect x="154" y="20" width="72" height="34" rx="3" fill="#1f3d36" />
                    <text x="190" y="35" fill="#efe8da" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">원격 서버</text>
                    <text x="190" y="47" fill="#d9c29a" font-size="8.5" font-family="var(--mono)" text-anchor="middle">Hetzner 24/7</text>
                    
                    <!-- 연결 화살표: 시계가 일을 깨운다 -->
                    <path d="M136 37 H150" stroke="#b8955c" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M147 34 L151 37 L147 40" stroke="#b8955c" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    
                    <!-- 하단 프로세스: 스케줄 실행 → 결재 대기 → PC 부팅 시 재개 -->
                    <path d="M190 54 V75 C190 82 186 86 180 86 H60 C54 86 50 82 50 75 V60" stroke="#2b4f46" stroke-width="1.8" fill="none" />
                    <path d="M47 62 L50 58 L53 62" stroke="#2b4f46" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    
                    <!-- 단계 배지들 -->
                    <rect x="130" y="74" width="60" height="24" rx="3" fill="#2b4f46" />
                    <text x="160" y="90" fill="#efe8da" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">결재 대기</text>

                    <rect x="42" y="74" width="76" height="24" rx="3" fill="#b8955c" />
                    <text x="80" y="90" fill="#1a2622" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">PC 켜질 때 재개</text>
                    
                    <!-- 설명 텍스트 -->
                    <text x="120" y="126" fill="#2f5a4f" font-size="10" font-weight="700" font-family="var(--sans)" text-anchor="middle">PC 꺼짐에도 서버 시계가 일을 깨운다</text>
                    <text x="120" y="139" fill="#67766f" font-size="8.5" font-family="var(--sans)" text-anchor="middle">스케줄러 분리 · 놓친 작업 즉시 추적</text>
                  </svg>
                )}
              </div>
            </div>
            <div class="beats">
              <div class="beat"><b>문제</b><p>{f.problem}</p></div>
              <div class="beat"><b>지은 것</b><p>{f.built}</p></div>
              <div class="beat result"><b>결과</b><p>{f.result}</p></div>
            </div>
            <button class="toggle" type="button" aria-expanded="false" aria-controls={`d-${f.anchor}`}>
              <span class="ar">+</span><span class="tx">자세히</span>
            </button>
            <div class="detail" id={`d-${f.anchor}`}>
              <div>
                <div class="detail-in">
                  {f.thumbType === 'image' && (
                    <div class="detail-media">
                      <img src={f.thumbSrc} alt={f.thumbAlt} loading="lazy" />
                    </div>
                  )}
                  {f.blocks.map((b) => (
                    <>
                      <h4>{b.h}</h4>
                      {b.list && (
                        <ul>
                          {b.list.map(([lead, text]) => <li><strong>{lead}</strong> — {text}</li>)}
                        </ul>
                      )}
                      {b.p && <p>{b.p}{b.strong && <> <strong>{b.strong}</strong></>}</p>}
                    </>
                  ))}
                  {f.stack && <p class="stack">{f.stack}</p>}
                  {f.href && <p class="more"><a href={f.href}>사례 전문 보기 →</a></p>}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <section class="rest" id="rest">
        <h3>나머지 {rest.length}개</h3>
        <p>대표 {featured.length}개를 받치거나 따로 굴러가는 것들입니다.</p>
        <ol>
          {rest.map((r) => (
            <li>
              <b>{r.href ? <a href={r.href}>{r.title}</a> : r.title}</b>
              <p>{r.text}</p>
              <time>{r.time}</time>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>

  <footer class="contact" id="contact">
    <svg viewBox="0 0 560 560" aria-hidden="true"><circle cx="280" cy="280" r="230" fill="none" stroke="#2b4f46" stroke-width="80"></circle></svg>
    <div class="contact-in">
      <h2>맡길 일이 있으면, 문장이 아니어도 됩니다.</h2>
