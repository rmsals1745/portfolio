---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroCinema from '../components/HeroCinema.astro';
import Reveal from '../components/Reveal.astro';
import StackDiagram from '../components/StackDiagram.astro';
import CaseCard from '../components/CaseCard.astro';
import CapabilityRow from '../components/CapabilityRow.astro';
import PullQuote from '../components/PullQuote.astro';
import { CATEGORIES } from '../content.config';

const all = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.weight - a.data.weight
);

const capabilities = (await getCollection('capabilities')).sort(
  (a, b) => a.data.order - b.data.order
);

const counts: Record<string, number> = {};
for (const c of all) counts[c.data.category] = (counts[c.data.category] ?? 0) + 1;

/** 층마다 첫 화면에 세우는 대표 사례 수. 이 숫자가 화면 길이를 고정한다. */
const PER_STRATUM = 2;

const ORDER = ['product', 'applied', 'agent-infra', 'ops'] as const;
const byId = Object.fromEntries(CATEGORIES.map((c) => [c.id, c]));

const strata = ORDER.map((id) => {
  const items = all.filter((c) => c.data.category === id);
  return {
    meta: byId[id],
    shown: items.slice(0, PER_STRATUM),
    rest: Math.max(0, items.length - PER_STRATUM),
  };
}).filter((s) => s.shown.length > 0);

/**
 * 숫자는 "얼마나 많이 했나"(투입량)가 아니라 "그래서 뭐가 달라졌나"(결과)를 재야 한다.
 * 커밋 수 · 파일 수는 채용관에게 오히려 경계 신호라 2026-08-16 전부 교체했다.
 */
const stats = [
  { value: '4개월', label: '첫 줄부터 결제 붙은<br>서비스 출시까지' },
  { value: '10', label: '지금도 돌아가고 있는<br>자작 시스템' },
  // ⚠️ 여기 "0건 검수 우회"를 걸었다가 사실 감사에서 뒤집혔다(2026-08-16).
  //    runs.jsonl 기간 내 approve 52건 중 2건이 verifier 없이 승인돼 있었다(둘 다 산출물 0인 빈 런).
  //    검증되는 숫자로 교체 — 지어낸 0 보다 검증된 17 이 세다.
  { value: '17/52', label: 'AI가 낸 작업 중 자동 검수가<br>되돌려보낸 횟수 (실측 전수)' },
  { value: '5', label: '한 곳이 죽어도 안 멈추게<br>묶어둔 LLM 프로바이더' },
];

/** 함께 일하는 두 경로. 손님이 둘(의뢰인 · 채용관)이라 여기서만 갈라준다. */
const MAIL = 'rmsals1745@gmail.com';
const tracks = [
  {
    h: '프로젝트를 맡기고 싶습니다',
    p: 'AI 자동화 · 에이전트 파이프라인 · 결제 붙은 서비스를 기획부터 배포까지 맡깁니다. 요구사항이 아직 문장이 아니어도 됩니다 — 캐내는 것부터가 제 일입니다.',
    cta: '의뢰 문의하기',
    href: `mailto:${MAIL}?subject=${encodeURIComponent('[프로젝트 의뢰] ')}`,
  },
  {
    h: '채용을 검토하고 있습니다',
    p: 'AI 인프라 · 에이전트 시스템 · 풀스택. 혼자 굴러가는 시스템을 짓는 사람이라, 팀에서도 남이 안 하는 자리를 맡습니다. 이력서와 상세 근거는 요청 주시면 보냅니다.',
    cta: '채용 문의하기',
    href: `mailto:${MAIL}?subject=${encodeURIComponent('[채용 문의] ')}`,
  },
];

const skills = [
  {
    h: 'Agent Systems',
    // "Claude Agent SDK" 는 뺐다 — 자작 코드에 import 가 없다(2026-08-16 전수 grep).
    // 실제로 하는 일은 CLI 를 서브프로세스로 띄워 프로바이더별 호환 엔드포인트로 라우팅하는 것이다.
    p: '멀티에이전트 오케스트레이션, 구현/검수 분리, tool-calling, 판정 프로토콜 설계, 프로바이더 폴백 체인, MCP 서버, Claude Code CLI 오케스트레이션, LangGraph (체크포인트 · HITL 인터럽트)',
  },
  {
    h: 'LLM Providers',
    p: 'Claude · GLM(z.ai) · DeepSeek · Kimi(Moonshot) · MiMo · Gemini — 장애 / 안전필터 거부 / 인코딩 손상을 서로 다른 실패 모드로 분류해 운용',
  },
  { h: 'Full-stack', p: 'TypeScript, React, Node 24, pnpm 모노레포, Astro, Vite, Capacitor, Python 3.12' },
  {
    h: 'Infra & Ops',
    p: 'Cloudflare Workers / Pages / D1 / KV, Hetzner + Docker(Caddy · CouchDB) + systemd + cron, Playwright, Vitest, 3중 백업 체계',
  },
  { h: 'Commerce', p: '포트원 V2, 빌링키 정기결제, 크레딧 원장, 환불 정산, 통신판매업 · PG 심사 요건' },
  {
    h: 'Generative Media',
    p: 'ComfyUI 로컬 추론(Z-Image-Turbo · LoRA · ControlNet · VideoX-Fun), Whisper STT, TTS 파이프라인',
  },
];
---

<Base
  title="박근민 — AI 자동화 시스템 설계 · 구현"
  description="AI 에이전트에게 일을 시키고, 그 결과를 믿을 수 있게 만듭니다. 4개월간 혼자 만들어 지금도 돌아가는 시스템 10개 — 결제 붙은 SaaS · 멀티모델 오케스트레이션 엔진 · 컨트롤 플레인."
>
  <HeroCinema next="#scale" />

  {/* 숫자만 있는 한 화면. 히어로와 섞으면 사진이 잘리고 밀도가 터진다. */}
  <section class="beat" id="scale">
    <div class="wrap">
      <Reveal>
        <p class="beat-lead">4개월 동안 혼자, 여기까지 만들어 돌리고 있습니다.</p>
      </Reveal>
      <Reveal each stagger={110} class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <dd data-count={s.value}>{s.value}</dd>
              <dt set:html={s.label} />
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  {/*
    역량이 층 단면보다 **앞**에 온다 (2026-08-16 순서 교체).
    처음 온 사람은 "이 사람이 뭘 쌓았나" 보다 "나한테 뭘 해줄 수 있나" 를 먼저 묻는다.
    구조 설명이 먼저 오면 자작 고유명사(just*)가 벽이 되어 거기서 이탈한다.
  */}
  {
    capabilities.length > 0 && (
      <section class="beat">
        <div class="wrap">
          <Reveal>
            <SectionHead
              num="01"
              title="저를 쓰면 무엇이 달라집니까"
              sub="기술 나열 대신, 실제로 만든 것에서 역산한 역량입니다. 항목마다 근거가 되는 실물이 아래에 있습니다."
            />
          </Reveal>
          <Reveal each stagger={140} class="caps">
            {capabilities.map((c, i) => (
              <CapabilityRow
                num={String(i + 1).padStart(2, '0')}
                claim={c.data.claim}
                why={c.data.why}
                evidenceLabel={c.data.evidenceLabel}
                evidence={c.data.evidence}
              />
            ))}
          </Reveal>
        </div>
      </section>
    )
  }

  <section class="beat">
    <div class="wrap">
      <Reveal>
        <SectionHead
          num="02"
          title="무엇을 어디까지 지었는가"
          sub="분야를 나열한 게 아니라 쌓은 순서대로 놓았습니다. 아래층이 없으면 위층이 서지 않습니다 — 층을 누르면 그 층의 사례만 모아 봅니다."
        />
      </Reveal>
      <StackDiagram counts={counts} />
    </div>
  </section>

  <section class="beat" id="work">
    <div class="wrap">
      <Reveal>
        <SectionHead
          num="03"
          title="사례"
          sub="층마다 대표 사례만 세웠습니다. 각 카드의 숫자는 추정이 아니라 실측이고, 근거는 상세 문서 안에 있습니다."
        />
      </Reveal>

      {
        strata.map((s) => (
          <div class="stratum-block">
            <div class="stratum-head">
              <h3>{s.meta.label}</h3>
              <span class="en">{s.meta.en}</span>
              <a class="all" href={`/category/${s.meta.id}/`}>
                {s.rest > 0 ? `이 층 ${s.rest}건 더 보기` : '이 층 전체 보기'}
              </a>
            </div>
            <div class="cards">
              {s.shown.map((entry) => (
                <CaseCard entry={entry} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="beat">
    <div class="wrap">
      <Reveal>
      <PullQuote>
        AI 시스템의 진짜 난이도는 모델을 부르는 데 있지 않습니다.<br />
        <span class="hl">“이 결과를 믿어도 되는가”</span> 를 사람 없이 판정하는 구조를 짜는 데 있습니다.
      </PullQuote>
      </Reveal>
    </div>
  </section>

  <section class="beat">
    <div class="wrap">
      <Reveal><SectionHead num="04" title="기술 스택" /></Reveal>
      <Reveal each stagger={80} class="skills">
        {
          skills.map((s) => (
            <div class="skill">
              <h4>{s.h}</h4>
              <p>{s.p}</p>
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  <section class="beat">
    <div class="wrap">
      <Reveal><SectionHead num="05" title="배경" /></Reveal>
      <Reveal><p class="bg">
        개발 이전에 <b>B2B 컨설팅 · 영업</b>을 했습니다. 니즈 발굴 → 문제 인식 → 해결책 제시 → 반론 처리 →
        클로징 → 사후관리까지 현장에서 굴린 경험이 있습니다. 그래서
        <b>고객 앞에 직접 설 수 있는 엔지니어</b>입니다 — 요구사항을 통역해서 받는 게 아니라 직접 캐내고,
        만든 것을 직접 설명합니다. 지금은 그 상담 플레이북을 AI 에이전트의 대화 설계에 그대로 이식하고 있습니다.
      </p></Reveal>
    </div>
  </section>

  {/*
    손님이 둘이다 — 일을 맡기러 온 사람과, 사람을 찾으러 온 사람.
    앞의 화면은 둘에게 똑같이 읽히도록 하나로 두고, **행동만** 여기서 갈라준다.
    입구에서 갈라놓으면 화면이 두 벌이 되고 첫인상이 흐려진다.
  */}
  <section class="beat" id="contact">
    <div class="wrap">
      <Reveal><SectionHead num="06" title="함께 일하는 두 가지 방법" /></Reveal>
      <Reveal each stagger={120} class="tracks">
        {
          tracks.map((t) => (
            <a class="track" href={t.href}>
              <h4>{t.h}</h4>
              <p>{t.p}</p>
              <span class="go">
                {t.cta}
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2.5 6.5h8M7 3l3.5 3.5L7 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))
        }
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* 한 화면에 한 덩어리. 여백이 곧 "다음 것"이라는 신호다. */
  .beat { padding: 15vh 0; }
  .beat + .beat { padding-top: 0; }

  .beat-lead {
    font-family: var(--serif);
    font-size: clamp(20px, 2.8vw, 27px);
    color: var(--ink);
    letter-spacing: -.01em;
    margin-bottom: 40px;
    max-width: 42ch;
  }

  /* 숫자 — 자기 화면을 가진다 */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat { padding: 36px 22px 36px 0; }
  .stat:not(:last-child) { border-right: 1px solid var(--rule); }
  .stat:not(:first-child) { padding-left: 22px; }
  .stats dd {
    font-family: var(--serif);
    font-size: clamp(30px, 4.6vw, 46px);
    color: var(--accent2);
    line-height: 1;
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums;
  }
  .stats dt { margin-top: 12px; font-size: 13px; color: var(--ink-faint); line-height: 1.55; }

  .caps { border-top: 1px solid var(--rule); }

  .stratum-block { margin-top: 44px; }
  .stratum-block:first-of-type { margin-top: 0; }
  .stratum-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 6px;
  }
  .stratum-head h3 { font-size: 15px; font-weight: 700; letter-spacing: .02em; color: var(--ink); }
  .stratum-head .en {
    font-family: var(--serif);
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: .05em;
  }
  .stratum-head .all {
    margin-left: auto;
    font-size: 13px;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .stratum-head .all:hover { color: var(--accent); }

  .cards { display: grid; gap: 2px; }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 34px;
    margin-top: 30px;
  }
  .skill h4 {
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 14px;
    font-weight: 700;
  }
  .skill p { color: var(--ink-dim); font-size: 15px; }

  .bg { color: var(--ink-dim); font-size: 16px; max-width: 700px; line-height: 1.85; }
  .bg b { color: var(--ink); font-weight: 650; }

  /* 두 갈래 — 카드가 아니라 문(門) 처럼 보이게 칸으로 나눈다 */
  .tracks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 30px;
    border-top: 1px solid var(--rule);
  }
  .track {
    display: block;
    padding: 32px 28px 28px;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: background var(--t-fast);
  }
  .track + .track { border-left: 1px solid var(--rule); }
  .track:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .track h4 {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -.01em;
  }
  .track p { color: var(--ink-dim); font-size: 15px; line-height: 1.75; }
  .track .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 13.5px;
    font-weight: 650;
    color: var(--accent);
  }
  .track .go svg { transition: transform var(--t-fast); }
  .track:hover .go svg { transform: translateX(3px); }

  .hl { color: var(--accent); }

  @media (max-width: 720px) {
    .beat { padding: 11vh 0; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat { padding: 26px 16px 26px 0; }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(3), .stat:nth-child(4) { border-top: 1px solid var(--rule); }
    .stat:nth-child(3) { padding-left: 0; }
    .track + .track { border-left: none; }
  }
</style>

<script>
  /* 숫자 카운트업 — 자기 화면에 들어올 때 한 번 (방향 C) */
  const els = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  if (els.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = (el: HTMLElement) => {
      const raw = el.dataset.count || '';
      // "1,464" / "700+" / "5" — 숫자만 뽑고 접두·접미는 보존한다
      const m = raw.match(/^([^\d]*)([\d,]+)(.*)$/);
      if (!m) return;
      const [, pre, numStr, post] = m;
      const target = parseInt(numStr.replace(/,/g, ''), 10);
      if (!isFinite(target) || target === 0) return;
      const comma = numStr.includes(',');
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1100);
        const v = Math.round(target * (1 - Math.pow(1 - k, 3)));
        el.textContent = pre + (comma ? v.toLocaleString('en-US') : String(v)) + post;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) {
          run(el);
        } else if (e.boundingClientRect.top > 0) {
          // 위로 올라가 화면 아래로 벗어났다 → 0 으로 되돌려 다시 셀 준비를 한다.
          // 접두·접미("4개월" 의 "개월")는 살려둔다 — 벗겨두면 되돌아올 때 맨 "0" 이 번쩍인다.
          const m0 = (el.dataset.count || '').match(/^([^\d]*)([\d,]+)(.*)$/);
          el.textContent = m0 ? m0[1] + '0' + m0[3] : '0';
        }
      });
    }, { threshold: 0.5 });
    els.forEach((el) => io.observe(el));
  }
</script>
