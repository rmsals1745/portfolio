                    <text x="95" y="43" fill="#1c302b" font-size="11" font-weight="700" font-family="var(--mono)" text-anchor="middle">diff</text>
                    <!-- 화살표 2 -->
                    <path d="M116 39 H128" stroke="#b8955c" stroke-width="2" stroke-linecap="round" />
                    <path d="M126 36 L130 39 L126 42" stroke="#b8955c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <!-- 게이트 -->
                    <rect x="130" y="24" width="44" height="30" rx="3" fill="#2b4f46" />
                    <text x="152" y="43" fill="#d9c29a" font-size="11" font-weight="700" font-family="var(--sans)" text-anchor="middle">게이트</text>
                    <!-- 화살표 3 -->
                    <path d="M174 39 H182" stroke="#b8955c" stroke-width="2" stroke-linecap="round" />
                    <path d="M180 36 L184 39 L180 42" stroke="#b8955c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <!-- 검수자 -->
