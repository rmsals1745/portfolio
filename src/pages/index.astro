---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroCinema from '../components/HeroCinema.astro';
import Reveal from '../components/Reveal.astro';
import StackDiagram from '../components/StackDiagram.astro';
import CasePage from '../components/CasePage.astro';
import CapabilityPage from '../components/CapabilityPage.astro';
import TerminalReplay from '../components/TerminalReplay.astro';
import PullQuote from '../components/PullQuote.astro';
import { CATEGORIES } from '../content.config';

const all = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.weight - a.data.weight
);

const capabilities = (await getCollection('capabilities')).sort(
  (a, b) => a.data.order - b.data.order
);

const counts: Record<string, number> = {};
for (const c of all) counts[c.data.category] = (counts[c.data.category] ?? 0) + 1;

/** 층마다 첫 화면에 세우는 대표 사례 수. 이 숫자가 화면 길이를 고정한다. */
const PER_STRATUM = 2;

const ORDER = ['product', 'applied', 'agent-infra', 'ops'] as const;
const byId = Object.fromEntries(CATEGORIES.map((c) => [c.id, c]));

const strata = ORDER.map((id) => {
  const items = all.filter((c) => c.data.category === id);
  return {
    meta: byId[id],
    shown: items.slice(0, PER_STRATUM),
    rest: Math.max(0, items.length - PER_STRATUM),
  };
}).filter((s) => s.shown.length > 0);

/**
 * 숫자는 "얼마나 많이 했나"(투입량)가 아니라 "그래서 뭐가 달라졌나"(결과)를 재야 한다.
 * 커밋 수 · 파일 수는 채용관에게 오히려 경계 신호라 2026-08-16 전부 교체했다.
 */
const stats = [
  { value: '4개월', label: '첫 줄부터 결제 붙은<br>서비스 출시까지' },
  { value: '10', label: '지금도 돌아가고 있는<br>자작 시스템' },
  // ⚠️ 여기 "0건 검수 우회"를 걸었다가 사실 감사에서 뒤집혔다(2026-08-16).
  //    runs.jsonl 기간 내 approve 52건 중 2건이 verifier 없이 승인돼 있었다(둘 다 산출물 0인 빈 런).
  //    검증되는 숫자로 교체 — 지어낸 0 보다 검증된 17 이 세다.
  { value: '17/52', label: 'AI가 낸 작업 중 자동 검수가<br>되돌려보낸 횟수 (실측 전수)' },
  { value: '5', label: '한 곳이 죽어도 안 멈추게<br>묶어둔 LLM 프로바이더' },
];

/**
 * 사례를 **한 장씩** 펼친다 (2026-08-16 사장 지시).
 * 층 순서를 유지한 채 평평하게 편다 — 층 이름은 각 장의 머리에 다시 붙으므로
 * 어느 층을 보는 중인지 놓치지 않는다.
 */
const CASE_SHOT: Record<string, { src: string; alt: string }> = {
  inlifeclick: {
    src: '/shots/inlife-login.jpg',
    alt: '인생딸깍 실서비스 진입 화면 — 소셜 로그인과 약관·환불규정·사업자 정보',
  },
  'just-design': {
    src: '/shots/justdesign-3variants.jpg',
    alt: 'JUST DESIGN 이 같은 소재로 만든 홈페이지 시안 세 가지',
  },
};

const caseList = strata.flatMap((s) =>
  s.shown.map((entry) => ({
    entry,
    stratum: s.meta.label,
    shot: CASE_SHOT[entry.id],
  }))
);

/**
 * 층마다 붙는 실물 한 장. 굴릴 때마다 이게 같이 바뀐다.
 * ★ 「자동화·운영」만 사진이 아니라 **실제 스케줄 목록**이다 —
 *   "PC 가 꺼져 있어도 돈다" 는 주장에는 웹 화면보다 이쪽이 증거로 세다.
 *   출처: `Get-ScheduledTask HermesCron_*` 실측 (2026-08-16, 가동 5 · 대기 10).
 */
const shots: Record<string, { src?: string; alt?: string; term?: string; cap: string }> = {
  product: {
    src: '/shots/inlife-login.jpg',
    alt: '인생딸깍 실서비스 진입 화면 — 소셜 로그인과 약관·환불규정·사업자 정보',
    cap: '인생딸깍 — 실제로 돈을 받는 화면. 약관 · 청약철회 · 사업자 정보까지 갖춰 놓았습니다.',
  },
  applied: {
    src: '/shots/justdesign-3variants.jpg',
    alt: 'JUST DESIGN 이 같은 소재로 만든 홈페이지 시안 세 가지',
    cap: 'JUST DESIGN — 같은 재료로 AI 세 명이 각자 만든 시안 3안. 검수 AI 가 판정합니다.',
  },
  'agent-infra': {
    src: '/shots/statusline.png',
    alt: 'CLI 하단에 지금 도는 외부 호출과 경과 시간이 표시된 상태 표시줄',
    cap: '실행 가시성 — 지금 어떤 호출이 몇 초째 도는지 항상 아래에 떠 있습니다.',
  },
  ops: {
    term: `PS> Get-ScheduledTask HermesCron_*

  HermesCron_ApiKeyCheck        Ready      08-16 19:15   0
  HermesCron_DesignCycle        Ready      08-16 23:00   0
  HermesCron_StudyDaemon        Ready      08-16 12:50   0
  HermesCron_SyncCronOutputs    Ready      08-16 23:00   0
  HermesCron_Worklist           Ready      08-16 22:05   0
  … 대기 10건

  가동 5 · 대기 10 · 실패 0`,
    cap: '중앙 게이트웨이가 죽어도 각자 도는 잡 15건. 놓친 실행은 기계가 켜지는 순간 따라잡습니다.',
  },
};

/** 함께 일하는 두 경로. 손님이 둘(의뢰인 · 채용관)이라 여기서만 갈라준다. */
const MAIL = 'rmsals1745@gmail.com';
const tracks = [
  {
    h: '프로젝트를 맡기고 싶습니다',
    p: 'AI 자동화 · 에이전트 파이프라인 · 결제 붙은 서비스를 기획부터 배포까지 맡깁니다. 요구사항이 아직 문장이 아니어도 됩니다 — 캐내는 것부터가 제 일입니다.',
    cta: '의뢰 문의하기',
    href: `mailto:${MAIL}?subject=${encodeURIComponent('[프로젝트 의뢰] ')}`,
  },
  {
    h: '채용을 검토하고 있습니다',
    p: 'AI 인프라 · 에이전트 시스템 · 풀스택. 혼자 굴러가는 시스템을 짓는 사람이라, 팀에서도 남이 안 하는 자리를 맡습니다. 이력서와 상세 근거는 요청 주시면 보냅니다.',
    cta: '채용 문의하기',
    href: `mailto:${MAIL}?subject=${encodeURIComponent('[채용 문의] ')}`,
  },
];

const skills = [
  {
    h: 'Agent Systems',
    // "Claude Agent SDK" 는 뺐다 — 자작 코드에 import 가 없다(2026-08-16 전수 grep).
    // 실제로 하는 일은 CLI 를 서브프로세스로 띄워 프로바이더별 호환 엔드포인트로 라우팅하는 것이다.
    p: '멀티에이전트 오케스트레이션, 구현/검수 분리, tool-calling, 판정 프로토콜 설계, 프로바이더 폴백 체인, MCP 서버, Claude Code CLI 오케스트레이션, LangGraph (체크포인트 · HITL 인터럽트)',
  },
  {
    h: 'LLM Providers',
    p: 'Claude · GLM(z.ai) · DeepSeek · Kimi(Moonshot) · MiMo · Gemini — 장애 / 안전필터 거부 / 인코딩 손상을 서로 다른 실패 모드로 분류해 운용',
  },
  { h: 'Full-stack', p: 'TypeScript, React, Node 24, pnpm 모노레포, Astro, Vite, Capacitor, Python 3.12' },
  {
    h: 'Infra & Ops',
    p: 'Cloudflare Workers / Pages / D1 / KV, Hetzner + Docker(Caddy · CouchDB) + systemd + cron, Playwright, Vitest, 3중 백업 체계',
  },
  { h: 'Commerce', p: '포트원 V2, 빌링키 정기결제, 크레딧 원장, 환불 정산, 통신판매업 · PG 심사 요건' },
  {
    h: 'Generative Media',
    // VideoX-Fun 은 뺐다 — 커스텀 노드 코드는 있는데 가중치가 없어 **지금 돌려 보일 수 없다**(8/16 감사).
    // 데모 못 하는 항목은 면접에서 부채가 된다. 가중치를 받으면 되살릴 것.
    p: 'ComfyUI 로컬 추론(Z-Image-Turbo · LoRA · ControlNet), Whisper STT, TTS 파이프라인',
  },
];
---

<Base
  deck
  title="박근민 — AI 자동화 시스템 설계 · 구현"
  description="AI 에이전트에게 일을 시키고, 그 결과를 믿을 수 있게 만듭니다. 4개월간 혼자 만들어 지금도 돌아가는 시스템 10개 — 결제 붙은 구독 서비스, AI끼리 서로 검사하게 만드는 엔진, 에이전트 관제 화면."
>
  <HeroCinema next="#scale" />

  {/* 숫자만 있는 한 화면. 히어로와 섞으면 사진이 잘리고 밀도가 터진다. */}
  <section class="page" data-page data-motion="rise" id="scale">
    <div class="wrap">
      <Reveal>
        <p class="beat-lead">4개월 동안 혼자, 여기까지 만들어 돌리고 있습니다.</p>
      </Reveal>
      <Reveal each stagger={110} class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <dd data-count={s.value}>{s.value}</dd>
              <dt set:html={s.label} />
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  {/*
    역량이 층 단면보다 **앞**에 온다 (2026-08-16 순서 교체).
    처음 온 사람은 "이 사람이 뭘 쌓았나" 보다 "나한테 뭘 해줄 수 있나" 를 먼저 묻는다.
    구조 설명이 먼저 오면 자작 고유명사(just*)가 벽이 되어 거기서 이탈한다.
  */}
  {
    capabilities.map((c, i) => (
      <section class="page" data-page data-motion="flip">
        <div class="wrap">
          {i === 0 && (
            <Reveal>
              <p class="over">저를 쓰면 무엇이 달라집니까 — 넷으로 답합니다</p>
            </Reveal>
          )}
          <Reveal>
            <CapabilityPage
              num={`${String(i + 1).padStart(2, '0')} / ${String(capabilities.length).padStart(2, '0')}`}
              claim={c.data.claim}
              why={c.data.why}
              product={c.data.product}
              productPlain={c.data.productPlain}
              facts={c.data.facts}
              evidence={c.data.evidence}
            />
          </Reveal>
        </div>
      </section>
    ))
  }

  {/*
    역량 바로 다음에 증거를 붙인다. 01 의 첫 주장이 "믿을 수 없는 출력을 믿을 수 있게" 인데,
    말로 한 번 더 설명하는 것보다 **실제 실행 기록 한 판**이 짧고 세다.
  */}
  <section class="page" data-page data-motion="type">
    <div class="wrap">
      <Reveal>
        <p class="beat-lead">말로 하면 길어지니, 실제로 돌아간 것을 한 판 보여드립니다.</p>
      </Reveal>
      <Reveal><TerminalReplay /></Reveal>
    </div>
  </section>

  {/*
    ★ 이 페이지는 **한 화면이 아니라 네 걸음**이다 (2026-08-16 사장 지시).
      "한 페이지 안에서도 이런 애들은 하나씩 스크롤 넘길 때마다 넘어가야지."
      맞다 — 층이 넷인데 한 번에 다 보여주면 넷 다 안 읽힌다.

      구조: 섹션 높이 = 층 수 × 한 화면. 안쪽 그림은 sticky 로 붙잡아 두고,
      **눈에 안 보이는 스냅 앵커**를 한 화면 간격으로 심었다. 굴릴 때마다 앵커 하나씩
      물리고, 그때마다 그 층이 열리며 그 층의 실물 사진이 바뀐다.
  */}
  <section
    class="page steps"
    data-page
    data-motion="stack"
    data-steps={strata.length}
    style={`--steps:${strata.length}`}
  >
    <div class="steps-pin">
      <div class="wrap">
        <Reveal>
          <SectionHead
            num="02"
            title="무엇을 어디까지 지었는가"
            sub="쌓은 순서대로 놓았습니다. 아래층이 없으면 위층이 서지 않습니다 — 굴릴 때마다 한 층씩 열립니다."
          />
        </Reveal>
        <div class="stage">
          <StackDiagram counts={counts} />
          <div class="shots">
            {
              strata.map((s, i) => (
                <figure class="shot" data-shot={i}>
                  {/* ★ loading 은 eager 다. lazy 로 두면 걸음이 넘어가는 순간
                      **빈 액자**가 뜬다 — 이미 화면 안에 있는 4장이라 미리 받아 둔다. */}
                  {shots[s.meta.id]?.src ? (
                    <img src={shots[s.meta.id].src} alt={shots[s.meta.id].alt} loading="eager" decoding="async" />
                  ) : (
                    <pre class="shot-term"><code>{shots[s.meta.id]?.term}</code></pre>
                  )}
                  <figcaption>{shots[s.meta.id]?.cap}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    {/* 보이지 않는 걸음 표시 — 한 화면 간격으로 스냅이 걸린다 */}
    {
      strata.map((_, i) => (
        <i class="snap" aria-hidden="true" style={`--i:${i}`} />
      ))
    }
  </section>

  {/*
    사례는 **층마다 한 페이지**다 (2026-08-16).
    한 화면에 8장을 몰아넣으면 아무것도 안 읽힌다 — 한 페이지에 한 층, 카드 2장.
    층 이름이 매 페이지 머리에 다시 서므로 어느 층을 보는 중인지 놓치지 않는다.
  */}
  {
    caseList.map((c, ci) => (
      <section
        class="page"
        data-page
        data-motion={ci % 2 === 0 ? 'slide-l' : 'slide-r'}
        id={ci === 0 ? 'work' : undefined}
      >
        <div class="wrap wide">
          {ci === 0 && (
            <Reveal>
              <p class="over">사례 — 층마다 대표만, 한 장씩</p>
            </Reveal>
          )}
          <Reveal>
            <CasePage
              entry={c.entry}
              stratum={c.stratum}
              pos={`${ci + 1} / ${caseList.length}`}
              shot={c.shot}
            />
          </Reveal>
        </div>
      </section>
    ))
  }

  <section class="page" data-page data-motion="zoom">
    <div class="wrap">
      <Reveal>
      <PullQuote>
        AI 시스템의 진짜 난이도는 모델을 부르는 데 있지 않습니다.<br />
        <span class="hl">“이 결과를 믿어도 되는가”</span> 를 사람 없이 판정하는 구조를 짜는 데 있습니다.
      </PullQuote>
      </Reveal>
    </div>
  </section>

  <section class="page" data-page data-motion="rise">
    <div class="wrap">
      <Reveal><SectionHead num="04" title="기술 스택" /></Reveal>
      <Reveal each stagger={80} class="skills">
        {
          skills.map((s) => (
            <div class="skill">
              <h4>{s.h}</h4>
              <p>{s.p}</p>
            </div>
          ))
        }
      </Reveal>
    </div>
  </section>

  <section class="page" data-page data-motion="fade">
    <div class="wrap">
      <Reveal><SectionHead num="05" title="배경" /></Reveal>
      <Reveal><p class="bg">
        개발 이전에 <b>B2B 컨설팅 · 영업</b>을 했습니다. 니즈 발굴 → 문제 인식 → 해결책 제시 → 반론 처리 →
        클로징 → 사후관리까지 현장에서 굴린 경험이 있습니다. 그래서
        <b>고객 앞에 직접 설 수 있는 엔지니어</b>입니다 — 요구사항을 통역해서 받는 게 아니라 직접 캐내고,
        만든 것을 직접 설명합니다. 지금은 그 상담 플레이북을 AI 에이전트의 대화 설계에 그대로 이식하고 있습니다.
      </p></Reveal>
    </div>
  </section>

  {/*
    손님이 둘이다 — 일을 맡기러 온 사람과, 사람을 찾으러 온 사람.
    앞의 화면은 둘에게 똑같이 읽히도록 하나로 두고, **행동만** 여기서 갈라준다.
    입구에서 갈라놓으면 화면이 두 벌이 되고 첫인상이 흐려진다.
  */}
  <section class="page" data-page data-motion="gate" id="contact">
    <div class="wrap">
      <Reveal><SectionHead num="06" title="함께 일하는 두 가지 방법" /></Reveal>
      <Reveal each stagger={120} class="tracks">
        {
          tracks.map((t) => (
            <a class="track" href={t.href}>
              <h4>{t.h}</h4>
              <p>{t.p}</p>
              <span class="go">
                {t.cta}
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2.5 6.5h8M7 3l3.5 3.5L7 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          ))
        }
      </Reveal>
    </div>
  </section>
</Base>

<style>
  /* ── 페이지 덱 (2026-08-16) ─────────────────────────────────────
     한 페이지 = 한 화면 = 한 덩어리의 정보. 한 번 굴리면 다음 페이지.

     ★ `height` 가 아니라 `min-height` 다. 내용이 화면보다 커지면 페이지가
       길어질 뿐, **잘리거나 갇히는 경우가 생기지 않는다.** 스냅에서 가장 흔한
       사고가 이것이라 처음부터 구조로 막았다.
     ──────────────────────────────────────────────────────────── */
  .page {
    box-sizing: border-box;
    /* ★ 100svh 가 아니라 「화면 − 헤더」다. 스냅이 헤더 높이만큼 내려서 붙이므로
       100svh 로 잡으면 페이지 아래쪽이 딱 그만큼 화면 밖으로 밀려난다. */
    min-height: calc(100svh - var(--header-h));
    scroll-snap-align: start;
    scroll-snap-stop: always;   /* 한 번에 여러 장 훌쩍 넘어가는 것을 막는다 */
    display: grid;
    align-content: center;
    padding: 4vh 0 5vh;   /* 헤더 보정은 scroll-padding-top 이 이미 했다 — 여기선 숨통만 */
    perspective: 1500px;
    perspective-origin: 50% 45%;
  }

  /* 화면보다 긴 페이지 — JS 가 재서 표시한다.
     여기서 `always` 를 풀지 않으면 굴리는 중간에 자꾸 붙잡혀 덜컥거린다.
     길어진 페이지는 그냥 평범하게 읽히는 게 맞다. */
  .page[data-tall] { scroll-snap-stop: normal; }

  /* 페이지 전환 연출 — 카메라 앞을 판이 지나간다.
     --off = 화면 중앙 기준 위치(-1 위 · 0 중앙 · +1 아래), --a = |--off|.
     스크롤할 때마다 JS 가 채운다. **값이 없으면 0 이라 평면 그대로** —
     스크립트가 죽어도 화면은 멀쩡하다(이 사이트의 기본 규칙). */
  /* ── 페이지마다 다른 연출 ──────────────────────────────────────
     사장 지적(2026-08-16): *"다 똑같은 페이지로 취급해서 같은 공식으로 넘기면 안 된다."*
     맞다. 숫자판과 긴 글과 한 문장짜리 화면이 같은 식으로 움직이면 전부 밋밋해진다.
     화면이 **무엇을 하는 화면인지**에 따라 움직임을 갈랐다 — `data-motion`.
     ──────────────────────────────────────────────────────────── */

  /* 기본값 (data-motion 이 없을 때) */
  :global(html.js) .page > .wrap {
    opacity: calc(1 - var(--a, 0) * 0.7);
    transform: translateY(calc(var(--off, 0) * 4%));
  }

  /* rise — 아래에서 솟는다. 숫자·스택처럼 "쌓인 것" 을 세우는 화면 */
  :global(html.js) .page[data-motion='rise'] > .wrap {
    transform: translateY(calc(var(--off, 0) * 9%)) scale(calc(1 - var(--a, 0) * 0.05));
  }

  /* flip — 카드가 돌아앉는다. 역량 네 장은 각각 "한 장의 카드" 다 */
  :global(html.js) .page[data-motion='flip'] > .wrap {
    transform:
      rotateY(calc(var(--off, 0) * 15deg))
      translateX(calc(var(--off, 0) * 5%))
      translateZ(calc(var(--a, 0) * -170px));
  }

  /* type — 글자를 읽어야 하는 화면. 움직임을 최소로 둔다 */
  :global(html.js) .page[data-motion='type'] > .wrap {
    transform: translateY(calc(var(--off, 0) * 4%));
    opacity: calc(1 - var(--a, 0) * 0.85);
  }

  /* stack — 층 단면. 깊이에서 앞으로 나온다(그림 자체가 층이라 Z 를 크게) */
  :global(html.js) .page[data-motion='stack'] > .wrap {
    transform: rotateX(calc(var(--off, 0) * -13deg)) translateZ(calc(var(--a, 0) * -400px));
  }

  /* slide — 사례. 층마다 좌우 교대로 밀려 들어온다(넘긴다는 느낌) */
  :global(html.js) .page[data-motion='slide-l'] > .wrap {
    transform: translateX(calc(var(--a, 0) * -10%)) rotateY(calc(var(--a, 0) * 10deg));
  }
  :global(html.js) .page[data-motion='slide-r'] > .wrap {
    transform: translateX(calc(var(--a, 0) * 10%)) rotateY(calc(var(--a, 0) * -10deg));
  }

  /* zoom — 한 문장짜리 화면. 크게 들어와 제자리에 선다 */
  :global(html.js) .page[data-motion='zoom'] > .wrap {
    transform: scale(calc(1 + var(--a, 0) * 0.22));
    opacity: calc(1 - var(--a, 0));
  }

  /* fade — 읽는 글. 움직이면 방해되니 밝기만 바뀐다 */
  :global(html.js) .page[data-motion='fade'] > .wrap {
    transform: none;
    opacity: calc(1 - var(--a, 0) * 0.9);
  }

  /* gate — 마지막 화면. 두 개의 문이 양쪽에서 닫히듯 모인다 */
  :global(html.js) .page[data-motion='gate'] > .wrap { transform: none; }
  :global(html.js) .page[data-motion='gate'] .track:first-child {
    transform: translateX(calc(var(--a, 0) * -16%));
  }
  :global(html.js) .page[data-motion='gate'] .track:last-child {
    transform: translateX(calc(var(--a, 0) * 16%));
  }

  /* ── 걸음 페이지 — 한 화면 안에서 N 걸음 ────────────────────────
     섹션은 「층 수 × 한 화면」만큼 길고, 안쪽 그림은 sticky 로 붙잡혀 있다.
     보이지 않는 앵커(.snap)가 한 화면 간격으로 심겨 있어 **굴릴 때마다 한 걸음**씩 물린다.
     ──────────────────────────────────────────────────────────── */
  .steps {
    position: relative;
    display: block;
    /* ★ `.page` 의 `align-content: center` 를 반드시 꺼야 한다.
       최신 크롬은 **블록 컨테이너에서도 align-content 가 동작**해서, 3,344px 짜리
       이 섹션의 정중앙(=1,254px 아래)으로 sticky 판을 밀어버린다.
       그러면 첫 걸음에서 화면이 통째로 빈다(2026-08-16 실측으로 잡음). */
    align-content: start;
    padding: 0;
    min-height: 0;
    height: calc(var(--steps) * (100svh - var(--header-h)));
    perspective: none;
    /* 스냅은 안쪽 앵커가 맡는다 — 섹션 자체가 스냅되면 걸음이 무시된다 */
    scroll-snap-align: none;
  }
  .steps-pin {
    position: sticky;
    top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: grid;
    align-content: center;
    padding: 3vh 0;
  }
  .snap {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    top: calc(var(--i) * (100svh - var(--header-h)));
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* 2단으로 펼치는 페이지(사례)는 통이 넓어야 양쪽이 다 읽힌다 */
  .wrap.wide { max-width: min(1240px, 92vw); }

  /* ★ 이 페이지만 통을 넓게 쓴다. 기본 폭(≈780px)을 둘로 나누면 한 칸이 380px 밖에
     안 돼서 화면 캡처가 알아볼 수 없게 눌린다(2026-08-16 실측). */
  .steps .wrap { max-width: min(1240px, 92vw); }

  /* 층 그림 ↔ 그 층의 실물, 나란히 */
  .stage {
    display: grid;
    grid-template-columns: .92fr 1.08fr;
    gap: clamp(22px, 3vw, 44px);
    align-items: center;
    margin-top: 24px;
  }
  .shots { position: relative; min-height: 34svh; }
  .shot {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 12px;
    opacity: 0;
    transform: translateY(10px) scale(.985);
    transition: opacity .45s ease, transform .45s ease;
    pointer-events: none;
  }
  /* JS 가 없으면 첫 장이라도 보여야 한다 — 빈 칸은 고장으로 읽힌다 */
  .shot:first-child { opacity: 1; transform: none; }
  .shots.js .shot { opacity: 0; transform: translateY(10px) scale(.985); }
  .shots.js .shot[data-on] { opacity: 1; transform: none; }

  /* ★ `cover` 를 쓰면 안 된다 — 상태표시줄처럼 **가로로 긴 이미지**가 통째로 확대돼
     글자 조각만 크게 보인다(2026-08-16 실측: "1% 210" 만 대문짝만하게 나왔다).
     비율이 제각각인 화면 캡처 4장을 한 틀에 넣으려면 `contain` 이 정답이다. */
  /* 높이를 못 박지 않는다 — 캡처마다 비율이 달라(상태표시줄은 가로로 길고 로그인 화면은
     거의 정사각) 한 높이에 맞추면 한쪽은 잘리고 한쪽은 빈 액자가 된다. 폭을 채우고 높이는 따라온다. */
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 44svh;
    object-fit: contain;
    background: var(--paper3);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
  }
  .shot figcaption {
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--ink-faint);
    word-break: keep-all;
  }
  .shot-term {
    margin: 0;
    padding: 18px 16px;
    background: var(--paper2);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    overflow-x: auto;
  }
  .shot-term code {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11.5px;
    line-height: 1.8;
    color: var(--ink-dim);
    white-space: pre;
  }

  @media (max-width: 900px) {
    .stage { grid-template-columns: 1fr; gap: 20px; }
    .shots { min-height: 30svh; }
  }

  /* 정지 선호 — 걸음을 없애고 한 화면으로 되돌린다 */
  @media (prefers-reduced-motion: reduce) {
    .steps { height: auto; padding: 12vh 0; }
    .steps-pin { position: static; height: auto; padding: 0; }
  }

  /* 역량 첫 장의 머리말 — 섹션 제목을 크게 세우면 주장과 제목이 둘 다 커져 싸운다 */
  .over {
    font-size: 12px;
    letter-spacing: .16em;
    color: var(--ink-faint);
    margin-bottom: 30px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule-soft);
  }

  /* 정지 선호 — 연출을 걷어낸다. 정보는 하나도 안 줄어든다 */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .page > .wrap { transform: none; opacity: 1; }
    .page { padding: 12vh 0; min-height: 0; }
  }

  .beat-lead {
    font-family: var(--serif);
    font-size: clamp(20px, 2.8vw, 27px);
    color: var(--ink);
    letter-spacing: -.01em;
    margin-bottom: 40px;
    max-width: 42ch;
  }

  /* 숫자 — 자기 화면을 가진다 */
  /* ★ 이 클래스들은 <Reveal> **컴포넌트의 루트**에 붙는다. Astro 스코프 CSS 는
     남의 컴포넌트 루트에 자기 cid 를 걸지 않으므로 `.stats { }` 는 **한 번도 적용된 적이 없다**
     (2026-08-16 computed style 실측: display:block). 자식(.stat)만 먹어서 세로로 쌓였다.
     → 루트 클래스는 :global 로 연다. 자식 선택자는 그대로 둬도 cid 가 붙어 잘 걸린다. */
  :global(.stats) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat { padding: 36px 22px 36px 0; }
  .stat:not(:last-child) { border-right: 1px solid var(--rule); }
  .stat:not(:first-child) { padding-left: 22px; }
  :global(.stats) dd {
    font-family: var(--serif);
    font-size: clamp(30px, 4.6vw, 46px);
    color: var(--accent2);
    line-height: 1;
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums;
  }
  :global(.stats) dt { margin-top: 12px; font-size: 13px; color: var(--ink-faint); line-height: 1.55; }

  .caps { border-top: 1px solid var(--rule); }

  .stratum-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 6px;
  }
  .stratum-head h3 { font-size: 15px; font-weight: 700; letter-spacing: .02em; color: var(--ink); }
  .stratum-head .en {
    font-family: var(--serif);
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: .05em;
  }
  /* 몇 번째 층을 보는 중인지 — 페이지가 갈라졌으니 위치 표시가 필요해졌다 */
  .stratum-head .pos {
    margin-left: auto;
    font-family: var(--serif);
    font-size: 12px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;
  }
  .stratum-head .all {
    margin-left: 18px;
    font-size: 13px;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .stratum-head .all:hover { color: var(--accent); }

  .cards { display: grid; gap: 2px; }

  :global(.skills) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 34px;
    margin-top: 30px;
  }
  .skill h4 {
    font-size: 12px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 14px;
    font-weight: 700;
  }
  .skill p { color: var(--ink-dim); font-size: 15px; }

  .bg { color: var(--ink-dim); font-size: 16px; max-width: 700px; line-height: 1.85; }
  .bg b { color: var(--ink); font-weight: 650; }

  /* 두 갈래 — 카드가 아니라 문(門) 처럼 보이게 칸으로 나눈다 */
  :global(.tracks) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 30px;
    border-top: 1px solid var(--rule);
  }
  .track {
    display: block;
    padding: 32px 28px 28px;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: background var(--t-fast);
  }
  .track + .track { border-left: 1px solid var(--rule); }
  .track:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }
  .track h4 {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -.01em;
  }
  .track p { color: var(--ink-dim); font-size: 15px; line-height: 1.75; }
  .track .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 13.5px;
    font-weight: 650;
    color: var(--accent);
  }
  .track .go svg { transition: transform var(--t-fast); }
  .track:hover .go svg { transform: translateX(3px); }

  .hl { color: var(--accent); }

  @media (max-width: 720px) {
    .beat { padding: 11vh 0; }
    :global(.stats) { grid-template-columns: repeat(2, 1fr); }
    .stat { padding: 26px 16px 26px 0; }
    .stat:nth-child(2) { border-right: none; }
    .stat:nth-child(3), .stat:nth-child(4) { border-top: 1px solid var(--rule); }
    .stat:nth-child(3) { padding-left: 0; }
    .track + .track { border-left: none; }
  }
</style>

<script>
  /* 숫자 카운트업 — 자기 화면에 들어올 때 한 번 (방향 C) */
  const els = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  if (els.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const run = (el: HTMLElement) => {
      const raw = el.dataset.count || '';
      // "1,464" / "700+" / "5" — 숫자만 뽑고 접두·접미는 보존한다
      const m = raw.match(/^([^\d]*)([\d,]+)(.*)$/);
      if (!m) return;
      const [, pre, numStr, post] = m;
      const target = parseInt(numStr.replace(/,/g, ''), 10);
      if (!isFinite(target) || target === 0) return;
      const comma = numStr.includes(',');
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1100);
        const v = Math.round(target * (1 - Math.pow(1 - k, 3)));
        el.textContent = pre + (comma ? v.toLocaleString('en-US') : String(v)) + post;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) {
          run(el);
        } else if (e.boundingClientRect.top > 0) {
          // 위로 올라가 화면 아래로 벗어났다 → 0 으로 되돌려 다시 셀 준비를 한다.
          // 접두·접미("4개월" 의 "개월")는 살려둔다 — 벗겨두면 되돌아올 때 맨 "0" 이 번쩍인다.
          const m0 = (el.dataset.count || '').match(/^([^\d]*)([\d,]+)(.*)$/);
          el.textContent = m0 ? m0[1] + '0' + m0[3] : '0';
        }
      });
    }, { threshold: 0.5 });
    els.forEach((el) => io.observe(el));
  }

  /* ── 페이지 덱: 전환 연출 + 위치 표시 ────────────────────────────
     각 페이지가 화면 중앙에서 얼마나 떨어져 있는지를 --off / --a 로 물려준다.
     CSS 가 그걸로 기울기·깊이·투명도를 만든다. 여기서 아무 일도 안 일어나면
     값이 0 이라 그냥 평면 문서가 된다 — 화면이 비는 경우가 없다.
     ──────────────────────────────────────────────────────────── */
  {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const pages = Array.from(document.querySelectorAll<HTMLElement>('[data-page]'));
    const slides: HTMLElement[] = hero ? [hero, ...pages] : pages;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (slides.length > 1) {
      // 위치 표시 — 어디쯤 왔는지 모르면 페이지 덱은 답답해진다
      const nav = document.createElement('nav');
      nav.className = 'deck-dots';
      nav.setAttribute('aria-label', '페이지 이동');
      const dots = slides.map((s, i) => {
        const b = document.createElement('button');
        const t = s.querySelector('h1, h2, h3, .beat-lead')?.textContent?.trim() ?? '';
        b.type = 'button';
        b.setAttribute('aria-label', t ? t.slice(0, 28) : `${i + 1}번째 화면`);
        b.addEventListener('click', () => s.scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth' }));
        nav.appendChild(b);
        return b;
      });
      document.body.appendChild(nav);

      let ticking = false;
      const sync = () => {
        ticking = false;
        const vh = window.innerHeight || 1;
        const off = still.matches;
        // 헤더에 가려지는 띠는 "보이는 화면" 이 아니다 — 높이 판정·덮임 계산에서 뺀다
        const headerH =
          parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 62;
        const view = Math.max(1, vh - headerH);
        let best = 0, bestD = Infinity;

        slides.forEach((s, i) => {
          const r = s.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - vh / 2);
          if (d < bestD) { bestD = d; best = i; }

          // 화면보다 긴 페이지는 스냅을 느슨하게 — 굴리는 중간에 자꾸 붙잡히면 덜컥거린다
          s.toggleAttribute('data-tall', r.height > view + 8);

          // 히어로는 3D 메시가 들어 있어 전환 변형을 걸지 않는다 (이중 원근 = 멀미)
          if (s === hero) return;
          if (off) { s.style.removeProperty('--off'); s.style.removeProperty('--a'); return; }

          /* ★ 거리를 「중심 간 거리」로 재면 안 된다 (2026-08-16 수정).
             화면보다 긴 페이지는 위쪽을 읽는 동안 중심이 한 화면 아래에 있어서
             **읽는 내내 반쯤 흐려진다.** 그래서 「화면을 얼마나 덮고 있는가」로 잰다 —
             어떤 페이지든 화면을 채우고 있는 동안에는 또렷하고, 물러날 때만 흐려진다. */
          const overlap = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, headerH));
          const cover = overlap / Math.max(1, Math.min(view, r.height));
          const a = Math.max(0, Math.min(1, 1 - cover));
          const dir = r.top + r.height / 2 - vh / 2 >= 0 ? 1 : -1;

          s.style.setProperty('--off', (a * dir).toFixed(3));
          s.style.setProperty('--a', a.toFixed(3));
        });

        dots.forEach((d, i) => d.setAttribute('aria-current', i === best ? 'true' : 'false'));
        stepSync(headerH, view);
      };

      /* ── 걸음 페이지: 지금 몇 번째 걸음인가 ──
         섹션이 헤더 아래를 얼마나 지났는지를 "한 화면" 단위로 나눈다.
         걸음이 바뀔 때만 손대므로(=cur 비교) 매 프레임 DOM 을 건드리지 않는다. */
      const steps = document.querySelector<HTMLElement>('.steps');
      const figs = steps ? Array.from(steps.querySelectorAll<HTMLElement>('[data-shot]')) : [];
      const layerBtns = steps
        ? Array.from(steps.querySelectorAll<HTMLButtonElement>('[data-toggle]'))
        : [];
      const shotBox = steps?.querySelector<HTMLElement>('.shots');
      if (shotBox && figs.length) shotBox.classList.add('js');
      let curStep = -1;

      function stepSync(headerH: number, view: number) {
        if (!steps || !figs.length) return;
        if (still.matches) return;
        const n = Number(steps.dataset.steps) || figs.length;
        const r = steps.getBoundingClientRect();
        const i = Math.max(0, Math.min(n - 1, Math.round((headerH - r.top) / view)));
        if (i === curStep) return;
        curStep = i;
        figs.forEach((f, k) => f.toggleAttribute('data-on', k === i));
        // 층 아코디언도 같이 연다 — 그림과 사진이 어긋나면 안 된다
        layerBtns.forEach((b, k) => b.setAttribute('aria-expanded', k === i ? 'true' : 'false'));
      }

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(sync);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      still.addEventListener('change', sync);
      requestAnimationFrame(sync);
    }
  }
</script>

<style is:global>
  /* 위치 표시 — 오른쪽 가장자리. 페이지 덱에서만 뜬다 */
  html:not(.deck) .deck-dots { display: none; }
  .deck-dots {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: grid;
    gap: 11px;
    padding: 10px 6px;
  }
  .deck-dots button {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--rule);
    cursor: pointer;
    transition: background .25s ease, transform .25s ease;
  }
  .deck-dots button:hover { background: var(--ink-faint); }
  .deck-dots button[aria-current='true'] {
    background: var(--accent);
    transform: scale(1.7);
  }
  .deck-dots button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* 좁은 화면에선 자리를 먹으니 숨긴다 */
  @media (max-width: 820px), (max-height: 640px) {
    .deck-dots { display: none; }
  }
</style>
