</style>

<script>
  document.querySelectorAll<HTMLElement>('.case .toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const c = btn.closest('.case');
      if (!c) return;
      const open = c.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      const tx = btn.querySelector('.tx');
      if (tx) tx.textContent = open ? '접기' : '자세히';
    });
  });

  /* 왼쪽 목차: 지금 읽는 섹션 표시 */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  if ('IntersectionObserver' in window && links.length) {
    const io = new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
          }
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    links.forEach((a) => {
      const el = document.getElementById((a.getAttribute('href') ?? '').slice(1));
      if (el) io.observe(el);
    });
  }
</script>