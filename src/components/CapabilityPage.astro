---
/**
 * 역량 한 장 = 한 페이지.
 *
 * 사장 지적(2026-08-16): *"이런건 카드 하나하나 좀 상세히 보여줘야지."*
 * 넷을 한 화면에 욱여넣으니 주장·이유·근거가 전부 작은 글씨 덩어리가 됐다.
 * 한 장에 하나만 두면 주장은 크게 세우고 근거는 **뜯어서** 보여줄 수 있다.
 *
 * ★ 그리고 자작 이름은 혼자 나오지 않는다. `justswarm` 은 처음 보는 사람에게
 *   아무 뜻도 없으므로 **바로 옆에 "그게 뭐 하는 물건인지"** 가 붙는다.
 */

interface Props {
  num: string;
  claim: string;
  why: string;
  product: string;
  productPlain: string;
  facts: { value: string; label: string }[];
  evidence: string;
}

const { num, claim, why, product, productPlain, facts, evidence } = Astro.props;
---

<div class="cap">
  <div class="say">
    <span class="num">{num}</span>
    <h2 set:html={claim} />
    <p class="why" set:html={why} />
  </div>

  <aside class="proof">
    <p class="kicker">이걸로 증명합니다</p>

    <h3 class="name">{product}</h3>
    <p class="plain" set:html={productPlain} />

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div>
              <dd>{f.value}</dd>
              <dt>{f.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <p class="detail" set:html={evidence} />
  </aside>
</div>

<style>
  .cap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(32px, 5vw, 72px);
    align-items: start;
  }

  /* ── 왼쪽: 주장 ── */
  .num {
    display: block;
    font-family: var(--serif);
    font-size: 13px;
    letter-spacing: .22em;
    color: var(--accent);
    margin-bottom: 20px;
  }
  h2 {
    font-family: var(--serif);
    font-size: clamp(27px, 3.6vw, 46px);
    line-height: 1.28;
    letter-spacing: -.02em;
    color: var(--ink);
    word-break: keep-all;
  }
  h2 :global(em) { font-style: normal; color: var(--accent); }

  .why {
    margin-top: 24px;
    font-size: clamp(14.5px, 1.25vw, 16.5px);
    line-height: 1.85;
    color: var(--ink-dim);
    max-width: 40ch;
    word-break: keep-all;
  }
  .why :global(b) { color: var(--ink); font-weight: 650; }

  /* ── 오른쪽: 근거 ── */
  .proof {
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    background: var(--paper2);
    padding: clamp(22px, 2.4vw, 32px);
  }
  .kicker {
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 16px;
  }

  /* 이름은 크게 — 다만 혼자 두지 않는다 */
  .name {
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--accent2);
  }
  .plain {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-dim);
    word-break: keep-all;
  }
  .plain :global(b) { color: var(--ink); font-weight: 650; }

  /* 수치 — 근거 안에서 가장 먼저 눈에 걸려야 한다 */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin: 24px 0;
    padding: 20px 0;
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .facts dd {
    font-family: var(--serif);
    font-size: clamp(22px, 2.4vw, 31px);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums;
  }
  .facts dt {
    margin-top: 9px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--ink-faint);
    word-break: keep-all;
  }

  .detail {
    font-size: 14px;
    line-height: 1.85;
    color: var(--ink-dim);
    word-break: keep-all;
  }
  .detail :global(b) { color: var(--ink); font-weight: 650; }
  .detail :global(em) { font-style: normal; color: var(--accent); font-weight: 600; }

  /* 좁은 화면 — 주장 먼저 읽고 근거로 내려간다 */
  @media (max-width: 900px) {
    .cap { grid-template-columns: 1fr; gap: 30px; }
    .why { max-width: none; }
    .facts { gap: 10px; margin: 20px 0; padding: 16px 0; }
    .facts dt { font-size: 10.5px; }
  }
</style>
