---
import { CATEGORIES, type CategoryId } from '../content.config';

interface Props {
  /** 카테고리별 사례 수 */
  counts: Record<string, number>;
}
const { counts } = Astro.props;

/**
 * 층 순서 — 위로 갈수록 사용자에게 가깝고, 아래로 갈수록 토대다.
 * 평면 그리드로 늘어놓지 않는 이유: 이 포트폴리오의 논지 자체가
 * "인프라를 짓고 그 위에 제품을 올린다" 라서, 배치가 곧 주장이다.
 *
 * 방향 B — 도식을 살아있게. 층 사이로 흐름이 보이고, 누르면 제자리에서 펼쳐진다.
 * 설명 문장을 접어 두니 첫 화면의 글자 수가 줄어든다.
 */
const ORDER: CategoryId[] = ['product', 'applied', 'agent-infra', 'ops'];
const byId = Object.fromEntries(CATEGORIES.map((c) => [c.id, c]));
const strata = ORDER.map((id) => ({ ...byId[id], count: counts[id] ?? 0 }));
---

<div class="diagram" data-diagram>
  <div class="axis" aria-hidden="true">
    <span class="axis-top">사용자에게 가까움</span>
    <span class="axis-line"></span>
    <span class="axis-bottom">토대</span>
  </div>

  <ul class="strata" data-scene>
    {
      strata.map((s, i) => (
        <li class="stratum" style={`--tint:${s.accent}; --d:${i * 90}ms; --i:${i}`}>
          {/* 판 하나 = 두께(edge) + 면(box). 파이프는 판 밖에 둔다 —
              안에 두면 두께가 파이프 길이만큼 늘어나 옆면이 어긋난다. */}
          <div class="plate">
          <span class="edge" aria-hidden="true" />
          <div class="box" data-box>
            <button class="toggle" data-toggle aria-expanded="false" aria-controls={`s-${s.id}`}>
              <span class="label">{s.label}</span>
              <span class="en">{s.en}</span>
              <span class="count" data-num={s.count}>
                {s.count}<i>건</i>
              </span>
              <span class="chev" aria-hidden="true" />
            </button>

            <div class="panel" id={`s-${s.id}`} data-panel>
              <div class="panel-in">
                <p class="blurb">{s.blurb}</p>
                <a class="go" href={`/category/${s.id}/`}>
                  이 층 {s.count}건 모아 보기
                  <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2.5 6.5h8M7 3l3.5 3.5L7 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          </div>
          </div>

          {i < strata.length - 1 && <div class="pipe" aria-hidden="true" />}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .diagram {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 22px;
    margin-top: 8px;
  }

  /* 왼쪽 세로 축 — 이 그림이 "쌓인 것"임을 말해주는 유일한 장치 */
  .axis {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding: 4px 0;
  }
  .axis-top, .axis-bottom {
    writing-mode: vertical-rl;
    font-size: 10.5px;
    letter-spacing: .14em;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .axis-line {
    width: 1px;
    background: linear-gradient(to bottom, var(--accent), var(--rule) 45%, var(--cool));
    margin: 10px 0;
    justify-self: center;
    align-self: stretch;
  }

  .strata { list-style: none; }
  .stratum { display: block; position: relative; }

  /* ───────────────────────────────────────────────────────────────
     입체 층 단면 (2026-08-16)

     three.js 를 쓰지 않은 이유: 층 이름·건수·링크는 **진짜 DOM**이어야 한다
     (읽기·선택·검색·스크린리더·기존 아코디언 전부 그대로 살려야 하므로).
     CSS 3D 면 번들 0KB 이고, 폴백이 곧 원래 화면이다.

     --p = 스크롤 진행도 0→1.  0 = 눌려 쌓인 상태(기울어짐), 1 = 평평하게 펴진 상태.
     ★ **기본값은 1(=읽을 수 있는 평면)** 이다. JS 가 죽든 reduced-motion 이든
       no-JS 든 사용자는 항상 멀쩡한 화면을 본다. 3D 는 얹는 것이지 전제가 아니다.
     ────────────────────────────────────────────────────────────── */
  .diagram { --p: 1; }

  @media (min-width: 641px) and (prefers-reduced-motion: no-preference) {
    /* 좁은 화면에서는 기울이지 않는다 — 가로 넘침 위험이 이득보다 크다 */
    :global(html.js) .strata {
      perspective: 1400px;
      perspective-origin: 50% 30%;
      /* 눌릴 때 판들이 위로 최대 66px(=3×22) 올라간다. 그대로 두면 섹션 제목을
         파고들므로 덩어리 전체를 절반만큼 내려 제자리에서 접히게 만든다. */
      transform: translateY(calc((1 - var(--p)) * 33px));
      transition: transform .18s linear;
    }
    :global(html.js) .plate {
      position: relative;
      transform-style: preserve-3d;
    }
    :global(html.js) .strata > .stratum {
      transform-style: preserve-3d;
      /* 눌린 상태에서는 위 층이 아래로 내려앉아 4장이 한 덩어리로 겹친다 */
      transform:
        rotateX(calc((1 - var(--p)) * 24deg))
        translateY(calc((1 - var(--p)) * var(--i) * -22px))
        translateZ(calc((1 - var(--p)) * var(--i) * -26px));
      transition: transform .18s linear;
    }
    /* 손을 올리면 그 판만 앞으로 떠오른다 — 만질 수 있는 물건이라는 신호 */
    :global(html.js) .strata > .stratum:hover {
      transform:
        rotateX(calc((1 - var(--p)) * 24deg))
        translateY(calc((1 - var(--p)) * var(--i) * -22px))
        translateZ(calc((1 - var(--p)) * var(--i) * -26px + var(--p) * 20px));
    }
    :global(html.js) .edge {
      position: absolute;
      inset: 0;
      border-radius: var(--r-sm);
      background: color-mix(in srgb, var(--tint) 30%, var(--paper2));
      /* 뒤로 밀고 아래로 내리면 기울어진 공간에서 '판의 옆면'으로 읽힌다 */
      transform: translateZ(-13px) translateY(7px);
      opacity: calc(1 - var(--p) * 0.55);
      pointer-events: none;
    }
  }

  /* 3D 가 꺼진 모든 경우(모바일·reduced-motion·no-JS)에는 두께가 없어야 한다 */
  .edge { display: none; }
  @media (min-width: 641px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .edge { display: block; }
  }

  /* 등장 — 아래에서 하나씩 올라온다 */
  .box {
    border-radius: var(--r-sm);
    background: var(--paper2);
    background-image: linear-gradient(
      to right,
      color-mix(in srgb, var(--tint) 9%, transparent),
      transparent 46%
    );
    border: 1px solid var(--rule-soft);
    overflow: hidden;
    transition: opacity .8s cubic-bezier(.22,1,.36,1) var(--d), transform .8s cubic-bezier(.22,1,.36,1) var(--d),
                border-color var(--t-fast), background-color var(--t-fast);
  }
  :global(html.js) .box { opacity: 0; transform: translateY(14px); }
  :global(html.js) .diagram.in .box { opacity: 1; transform: none; }
  .box:hover { background-color: var(--paper-lift); border-color: color-mix(in srgb, var(--tint) 42%, var(--rule)); }
  .box:has(.toggle[aria-expanded='true']) {
    border-color: color-mix(in srgb, var(--tint) 55%, var(--rule));
    background-color: var(--paper-lift);
  }

  .toggle {
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 19px 22px;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
  }
  .label { font-size: 18px; font-weight: 650; color: var(--ink); letter-spacing: -.01em; }
  .en {
    font-family: var(--serif);
    font-size: 12.5px;
    color: var(--ink-faint);
    letter-spacing: .04em;
  }
  .count {
    margin-left: auto;
    font-family: var(--serif);
    font-size: 22px;
    color: var(--tint);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .count i { font-style: normal; font-size: 11.5px; color: var(--ink-faint); margin-left: 3px; }

  .chev {
    flex: 0 0 auto;
    width: 9px; height: 9px;
    border-right: 1.5px solid var(--ink-faint);
    border-bottom: 1.5px solid var(--ink-faint);
    transform: rotate(45deg) translateY(-2px);
    transition: transform .3s cubic-bezier(.2,.7,.2,1), border-color .2s;
    align-self: center;
  }
  .toggle[aria-expanded='true'] .chev {
    transform: rotate(-135deg) translateY(-2px);
    border-color: var(--accent);
  }

  /* 제자리 펼침 — 새 화면으로 튀지 않는다 */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .34s cubic-bezier(.2,.7,.2,1);
  }
  .toggle[aria-expanded='true'] + .panel { grid-template-rows: 1fr; }
  .panel-in { overflow: hidden; }
  .blurb {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--ink-dim);
    padding: 0 22px 4px;
    max-width: 66ch;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 12px 22px 20px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--tint);
    text-decoration: none;
    transition: gap var(--t-fast);
  }
  .go:hover { gap: 10px; }

  /* 층 사이 흐름 — 데이터가 아래에서 위로 올라간다 */
  .pipe {
    height: 16px;
    width: 2px;
    margin: 0 0 0 34px;
    background: var(--rule-soft);
    position: relative;
    overflow: hidden;
  }
  .pipe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, transparent, var(--accent), transparent);
    transform: translateY(100%);
  }
  .diagram.in .pipe::after { animation: flow 2.6s linear infinite; }
  @keyframes flow {
    to { transform: translateY(-100%); }
  }

  @media (max-width: 640px) {
    .diagram { grid-template-columns: 1fr; }
    .axis { display: none; }
    .toggle { padding: 16px 15px; gap: 9px; }
    .label { font-size: 16.5px; }
    .en { display: none; }
    .blurb { padding: 0 15px 4px; font-size: 13.5px; }
    .go { margin: 10px 15px 16px; }
    .pipe { margin-left: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .box { opacity: 1; transform: none; transition: none; }
    .panel { transition: none; }
    .diagram.in .pipe::after { animation: none; }
  }
</style>

<script>
  const diagram = document.querySelector<HTMLElement>('[data-diagram]');
  if (diagram) {
    // 화면에 들어오면 층이 하나씩 올라오고 흐름이 시작된다
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) diagram.classList.add('in');
        else if (e.boundingClientRect.top > 0) diagram.classList.remove('in');
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    io.observe(diagram);

    // 아코디언 — 한 번에 하나만 열린다 (한 화면 한 결정)
    const toggles = Array.from(diagram.querySelectorAll<HTMLButtonElement>('[data-toggle]'));
    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        toggles.forEach((b) => b.setAttribute('aria-expanded', 'false'));
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });

    /* 입체 층 단면 — 스크롤 진행도(--p) 를 물려준다.
       0 = 4장이 눌려 겹친 채 기울어짐 / 1 = 평평하게 펴져 읽히는 상태.

       ★ CSS 기본값이 이미 1(평면)이므로, 여기서 아무 일도 안 일어나도 화면은 멀쩡하다.
         3D 는 더하는 것이지 화면이 서기 위한 조건이 아니다. 좁은 화면·reduced-motion 은
         아예 손대지 않는다(가로 넘침 위험 > 이득). */
    const wide = window.matchMedia('(min-width: 641px)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let ticking = false;
    const applyDepth = () => {
      ticking = false;
      if (!wide.matches || still.matches) {
        diagram.style.removeProperty('--p');
        return;
      }
      const r = diagram.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      // 화면 아래에 막 걸쳤을 때 0 → 화면 위쪽 45% 지점에 닿으면 1
      const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.55)));
      diagram.style.setProperty('--p', p.toFixed(3));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(applyDepth);
    };

    applyDepth();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    wide.addEventListener('change', applyDepth);
    still.addEventListener('change', applyDepth);

    // 처음 한 번 맨 위를 열어 "눌리는 것" 임을 알린다
    if (toggles[0] && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setTimeout(() => {
        if (toggles.every((b) => b.getAttribute('aria-expanded') === 'false')) {
          toggles[0].setAttribute('aria-expanded', 'true');
        }
      }, 900);
    }
  }
</script>
