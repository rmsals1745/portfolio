---
import { CATEGORIES } from '../content.config';

const path = Astro.url.pathname;
---

{/* 3-B — 표지와 같은 초록 색면 띠. 안쪽 페이지 전용(첫 화면은 자기 표지 상단을 쓴다). */}
<header class="bar">
  <div class="wrap-wide inner">
    <a href="/" class="mark" aria-label="박근민 포트폴리오 첫 화면">
      <span class="mark-nm">박근민</span>
      <span class="mark-en">Justin Avery Park</span>
    </a>

    <nav aria-label="분야">
      <ul>
        {
          CATEGORIES.map((c) => (
            <li>
              <a
                href={`/category/${c.id}/`}
                aria-current={path.startsWith(`/category/${c.id}`) ? 'page' : undefined}
              >
                {c.label}
              </a>
            </li>
          ))
        }
        <li><a href="/#contact">연락</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    background: var(--field);
    color: var(--cream);
  }
  .inner {
    display: flex;
    align-items: baseline;
    gap: 28px;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .mark {
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex: 0 0 auto;
    color: var(--cream);
  }
  .mark-nm { font-size: 17px; font-weight: 700; }
  .mark-en { font-size: 14px; font-weight: 500; opacity: .75; }

  nav { margin-left: auto; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav ul {
    list-style: none;
    display: flex;
    gap: 26px;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 13.5px;
    letter-spacing: .03em;
  }
  nav a {
    color: var(--cream);
    text-decoration: none;
    font-weight: 600;
    opacity: .8;
    padding: 4px 0;
    transition: opacity var(--t-fast), color var(--t-fast);
  }
  nav a:hover { opacity: 1; color: var(--brass-soft); }
  nav a[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  @media (max-width: 860px) {
    .mark-en { display: none; }
    .inner { gap: 18px; padding-top: 16px; padding-bottom: 16px; }
    nav ul { gap: 18px; font-size: 12.5px; }
  }
</style>
