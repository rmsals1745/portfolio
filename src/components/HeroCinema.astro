---
/**
 * 히어로 — 고정 후 조립 (방향 A, 사장 선택 2026-08-15).
 *
 * 스크롤한 만큼 문장 → 소개 → 버튼이 차례로 조립되고, 다 되면 놓아준다.
 * 속도를 사용자가 쥔다 — 천천히 굴리면 천천히 조립된다.
 *
 * ⚠️ 앞선 시도에서 낸 사고 4개를 그대로 피한다:
 *   1. 제목이 sticky 헤더에 잘림    → pin 안쪽에 헤더 높이만큼 padding
 *   2. 조사가 줄바꿈에서 떨어져 나감 → 단어를 쪼개지 않는다. **줄 단위**만 움직인다
 *   3. 사진이 숫자판에 잘림          → 사진·숫자는 히어로에서 뺐다 (푸터 / 다음 섹션)
 *   4. 활주로가 빈 공간으로 남음     → 활주로는 pin 이 덮는다. 빈 화면이 생길 수 없다
 *
 * 갇힘 방지: 활주로는 1화면(100svh)뿐이고, 건너뛰는 길이 처음부터 보인다.
 */

interface Props {
  /** 히어로를 지나면 도달할 첫 섹션 앵커 */
  next: string;
}
const { next } = Astro.props;
---

<section class="hero" data-hero>
  <div class="pin">
    <div class="wrap inner">
      <p class="eyebrow" data-step="0">AI Infrastructure · Agent Systems Engineer</p>

      <h1>
        <span class="ln" data-step="1"><span>에이전트를 굴리는 <em>인프라</em>를 짓고,</span></span>
        <span class="ln" data-step="2"><span>그 위에 제품을 올립니다.</span></span>
      </h1>

      <p class="lede" data-step="3">
        인프라만 만든 사람도, 제품만 만든 사람도 아닙니다.
      </p>

      <a class="cta" data-step="4" href={next}>
        무엇을 지었는지 보기
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2.5v9M3.5 8L7 11.5 10.5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    {/*
      스크롤 유도 — 화면 가운데 아래. 크게 움직여서 "고장난 게 아니라
      굴리면 이어진다" 를 한눈에 알게 한다. 굴리기 시작하면 사라진다.
    */}
    <div class="cue" data-cue aria-hidden="true">
      <span class="mouse"><span class="wheel"></span></span>
      <span class="chevs">
        <svg viewBox="0 0 22 9" width="22" height="9" style="--c:0"><path d="M2 2l9 5 9-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <svg viewBox="0 0 22 9" width="22" height="9" style="--c:1"><path d="M2 2l9 5 9-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="cue-t">스크롤하면 이어집니다</span>
    </div>

    {/* 갇히지 않게 — 조립을 기다리지 않고 바로 갈 수 있다 */}
    <a class="bail" href={next}>건너뛰기</a>

    <div class="bar" data-bar aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"><i class="g1"></i><i class="g2"></i></div>
  </div>
</section>

<style>
  /* 전체 높이 = 붙잡히는 1화면 + 조립용 활주로 1화면.
     활주로는 pin 이 덮으므로 빈 화면이 생기지 않는다. */
  .hero { position: relative; height: 200svh; }

  .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-content: center;
    overflow: hidden;
    /* sticky 헤더(62px) 아래로 — 이걸 빼먹어 제목 윗줄이 잘렸다 */
    padding-top: 62px;
  }

  /* ── 빛 ──
     ⚠️ 예전엔 top:-220px 로 컨테이너 밖까지 나가 있었고, overflow:hidden 이
        그걸 잘라 헤더 바로 밑에 **직선**이 생겼다.
        이제 빛덩이는 컨테이너 안에 완전히 들어와 있고, 제 가장자리에서
        이미 투명해진 상태다 — 어디서 잘리든 선이 생길 수 없다. */
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  .glow i {
    position: absolute;
    display: block;
    border-radius: 50%;
    /* 가장자리로 갈수록 완전히 사라진다. 65% 지점에서 이미 0. */
    background: radial-gradient(circle at 50% 50%,
                var(--c1) 0%, var(--c2) 34%, transparent 66%);
    filter: blur(28px);
    will-change: transform;
  }
  .g1 {
    --c1: rgba(224, 114, 58, .26);
    --c2: rgba(224, 114, 58, .09);
    width: min(72vw, 780px);
    aspect-ratio: 1;
    top: -14%;
    right: -12%;
    animation: drift1 26s ease-in-out infinite;
  }
  /* 두 번째 덩이 — 색을 살짝 달리해 깊이를 준다 */
  .g2 {
    --c1: rgba(92, 158, 173, .12);
    --c2: rgba(92, 158, 173, .04);
    width: min(56vw, 600px);
    aspect-ratio: 1;
    bottom: -22%;
    left: -14%;
    animation: drift2 34s ease-in-out infinite;
  }
  @keyframes drift1 {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50%      { transform: translate3d(-4%, 5%, 0) scale(1.08); }
  }
  @keyframes drift2 {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50%      { transform: translate3d(6%, -5%, 0) scale(1.12); }
  }

  .inner { position: relative; z-index: 1; }

  .eyebrow { margin-bottom: 26px; }
  h1 { margin-bottom: 30px; }
  h1 em { font-style: normal; color: var(--accent); }

  /* 줄 단위로만 움직인다 — 줄 안쪽 텍스트는 손대지 않으니 조판이 깨질 수 없다 */
  .ln { display: block; overflow: hidden; }
  .ln > span { display: block; }

  .lede {
    font-size: clamp(17px, 2.1vw, 20px);
    color: var(--ink-dim);
    max-width: 46ch;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 40px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 12px 22px;
    border-radius: 99px;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast), gap var(--t-fast);
  }
  .cta:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); gap: 13px; }

  /* ── 스크롤 유도 ──
     화면 가운데 아래에 크게. 작으면 사람들이 못 보고 "화면이 안 넘어간다" 로 읽는다. */
  .cue {
    position: absolute;
    left: 0; right: 0;
    /* 바닥에 딱 붙으면 눈에 안 들어온다. 한 뼘 올려 시야 안으로. */
    bottom: 13vh;
    display: grid;
    justify-items: center;
    gap: 9px;
    pointer-events: none;
    transition: opacity .45s ease, transform .45s ease;
  }
  .cue[data-gone] { opacity: 0; transform: translateY(10px); }

  /* 마우스 — 로드 순간부터 계속 구른다. 정지 화면이면 고장으로 읽힌다. */
  .mouse {
    width: 24px; height: 37px;
    border: 1.6px solid var(--ink-dim);
    border-radius: 12px;
    position: relative;
    display: block;
    animation: mouse-bob 2.2s ease-in-out infinite;
  }
  .wheel {
    position: absolute;
    left: 50%; top: 7px;
    width: 3px; height: 7px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%);
    animation: wheel 1.6s cubic-bezier(.22,1,.36,1) infinite;
  }
  @keyframes wheel {
    0%   { opacity: 0; transform: translate(-50%, 0); }
    22%  { opacity: 1; }
    68%  { opacity: 0; transform: translate(-50%, 11px); }
    100% { opacity: 0; transform: translate(-50%, 11px); }
  }
  /* 마우스 자체도 살짝 오르내려 "멈춘 화면" 이 아님을 알린다 */
  @keyframes mouse-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }

  .chevs {
    display: grid;
    gap: 0;
    color: var(--accent);
  }
  .chevs svg {
    display: block;
    opacity: 0;
    animation: chev 1.9s cubic-bezier(.22,1,.36,1) infinite;
    /* 위에서 아래로 차례로 흘러 방향을 못박는다 */
    animation-delay: calc(var(--c) * .18s);
  }
  @keyframes chev {
    0%   { opacity: 0; transform: translateY(-4px); }
    30%  { opacity: .95; }
    62%  { opacity: .2; }
    100% { opacity: 0; transform: translateY(6px); }
  }

  .cue-t {
    font-size: 12.5px;
    color: var(--ink-dim);
    letter-spacing: .04em;
    animation: breathe 2.6s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { opacity: .55; }
    50%      { opacity: 1; }
  }

  .bail {
    position: absolute;
    right: 26px; bottom: 30px;
    font-size: 12.5px;
    color: var(--ink-faint);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .bail:hover { color: var(--accent); border-color: var(--accent); }

  .bar {
    position: absolute;
    left: 0; bottom: 0;
    height: 2px; width: 0;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
  }

  /* ── 조립 상태 ──
     숨김은 html.js 가 붙었을 때만. 스크립트가 죽어도 백지가 되지 않는다.
     ⚠️ 숨김/표시 쌍은 반드시 같은 접두사를 써야 한다 — 한쪽만 :global 하면
        우선순위가 뒤집혀 영원히 안 보인다(실제로 카드가 그렇게 사라졌다). */
  :global(html.js) [data-step] {
    opacity: 0;
    transition: opacity .55s cubic-bezier(.22,1,.36,1), transform .55s cubic-bezier(.22,1,.36,1);
  }
  :global(html.js) .ln[data-step] { opacity: 1; }
  :global(html.js) .ln[data-step] > span {
    transform: translateY(105%);
    transition: transform .75s cubic-bezier(.22,1,.36,1);
  }
  :global(html.js) .eyebrow[data-step],
  :global(html.js) .lede[data-step],
  :global(html.js) .cta[data-step] { transform: translateY(14px); }

  :global(html.js) [data-step].on { opacity: 1; transform: none; }
  :global(html.js) .ln[data-step].on > span { transform: none; }
  /* ⚠️ 위 한 줄만으로는 .eyebrow/.lede/.cta 숨김 규칙과 **우선순위 동점**이라
     소스 순서에만 기대게 된다. 명시적으로 이기게 클래스를 맞춰 둔다. */
  :global(html.js) .eyebrow[data-step].on,
  :global(html.js) .lede[data-step].on,
  :global(html.js) .cta[data-step].on { transform: none; }

  @media (max-width: 720px) {
    .hero { height: 190svh; }
    .pin { padding-top: 62px; }
    h1 { margin-bottom: 24px; }
    .cta { margin-top: 30px; }
    .cue { bottom: 26px; }
    /* 좁은 화면에서는 가운데 유도 표시와 겹치므로 위로 올려 자리를 가른다 */
    .bail { right: 18px; bottom: auto; top: calc(62px + 14px); }
  }

  /* 모션을 원치 않으면 붙잡지 않고 완성 상태를 즉시 준다 */
  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .pin { position: static; height: auto; padding: calc(62px + 8vh) 0 10vh; }
    :global(html.js) [data-step],
    :global(html.js) .ln[data-step] > span { opacity: 1 !important; transform: none !important; }
    .cue, .bar { display: none; }
    .chevs svg, .cue-t, .mouse, .wheel { animation: none; opacity: 1; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.hero [data-step]'));
  const cue = document.querySelector<HTMLElement>('[data-cue]');
  const bar = document.querySelector<HTMLElement>('[data-bar]');

  // 살아났다고 알린다 — 없으면 2.5초 뒤 failsafe 가 강제로 다 보여준다
  document.documentElement.classList.add('hero-ready');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce || !hero) {
    steps.forEach((el) => el.classList.add('on'));
  } else {
    /*
      ★ 스크롤 전에 이미 보여야 하는 조각 수.
        예전엔 0 이라 첫 화면이 사실상 백지였다 — 스크롤해야 뭐가 뜨니
        사람들이 "고장났다" 로 읽는다. 스크롤하라고 알려주는 화면이
        스크롤해야 보이면 앞뒤가 안 맞는다.
        라벨과 첫 문장은 처음부터 보이고, 나머지가 굴린 만큼 붙는다.
    */
    const FREE = 2;

    const sync = () => {
      // 활주로 = 전체 높이 - 붙잡히는 1화면. 그 구간을 얼마나 지났는가.
      const runway = hero.offsetHeight - window.innerHeight;
      const p = runway > 0
        ? Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / runway))
        : 1;

      // 1.25 를 곱해 활주로가 끝나기 전에 조립이 완성되게 — 끝까지 끌면 답답하다
      const rest = steps.length - FREE;
      const shown = FREE + Math.round(p * rest * 1.25);
      steps.forEach((el, i) => el.classList.toggle('on', i < shown));

      if (bar) bar.style.width = (p * 100).toFixed(1) + '%';
      // 굴리기 시작하면 유도 표시를 거둔다
      if (cue) cue.toggleAttribute('data-gone', p > 0.04);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { sync(); ticking = false; });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // sync 가 FREE 만큼을 알아서 켠다. 여기서 따로 켜면 sync 가 도로 꺼버린다.
    requestAnimationFrame(sync);
  }
</script>
