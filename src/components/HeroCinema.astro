---
/**
 * 히어로 — 한 화면에 한 덩어리.
 *
 * ★ 앞선 판(sticky + 활주로)을 버린 이유:
 *   - sticky 헤더 높이를 계산하지 않아 제목 윗줄이 잘렸다
 *   - 단어를 조각내 inline-block 으로 만들었더니 "인프라 / 를 짓고," 처럼
 *     조사가 줄바꿈에서 떨어져 나갔다. 한글 조판에서 가장 하면 안 되는 것.
 *   - 활주로가 빈 공간으로 남고 숫자판이 사진을 덮었다.
 *
 * 지금 방식: **줄 단위** 등장. 줄 안쪽 텍스트는 손대지 않으니 조판이 깨질 수 없다.
 * 히어로에는 문장 하나와 다음으로 가는 길만 둔다. 나머지는 아래에서 하나씩.
 */

interface Props {
  /** 첫 화면 아래에서 이어질 첫 섹션의 앵커 */
  next: string;
}
const { next } = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow" data-line style="--d:0ms">AI Infrastructure · Agent Systems Engineer</p>

    <h1>
      <span class="ln" data-line style="--d:120ms">
        <span>에이전트를 굴리는 <em>인프라</em>를 짓고,</span>
      </span>
      <span class="ln" data-line style="--d:260ms">
        <span>그 위에 제품을 올립니다.</span>
      </span>
    </h1>

    <p class="lede" data-line style="--d:440ms">
      인프라만 만든 사람도, 제품만 만든 사람도 아닙니다.
    </p>

    <div class="cue" data-line style="--d:620ms">
      <a class="go" href={next}>
        무엇을 지었는지 보기
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2.5v9M3.5 8L7 11.5 10.5 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <span class="hint">스크롤하면 하나씩 나옵니다</span>
    </div>
  </div>

  <div class="glow" aria-hidden="true"></div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    align-content: center;
    position: relative;
    overflow: hidden;
    /* sticky 헤더(62px) 아래로 내려앉게 — 이걸 빼먹어 제목이 잘렸다 */
    padding: calc(62px + 6vh) 0 12vh;
  }

  .glow {
    position: absolute;
    top: -220px; right: -200px;
    width: 620px; height: 620px;
    background: radial-gradient(circle, rgba(224, 114, 58, .18), transparent 62%);
    pointer-events: none;
  }

  .eyebrow { margin-bottom: 26px; }

  h1 { margin-bottom: 30px; }

  /* 줄 단위 등장 — 줄 안쪽 텍스트는 건드리지 않으므로 조판이 깨질 수 없다 */
  .ln {
    display: block;
    overflow: hidden;
  }
  .ln > span { display: block; }
  h1 em { font-style: normal; color: var(--accent); }

  .lede {
    font-size: clamp(17px, 2.1vw, 20px);
    color: var(--ink-dim);
    max-width: 46ch;
  }

  .cue {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--rule);
    padding: 12px 22px;
    border-radius: 99px;
    transition: color var(--t-fast), border-color var(--t-fast), background var(--t-fast), gap var(--t-fast);
  }
  .go:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); gap: 13px; }
  .go svg { animation: nudge 2.4s ease-in-out infinite; }
  @keyframes nudge {
    0%, 70%, 100% { transform: translateY(0); }
    82% { transform: translateY(3px); }
  }
  .hint { font-size: 13px; color: var(--ink-faint); }

  /* ── 등장 모션 ──
     숨김은 html.js 가 붙었을 때만. 스크립트가 죽어도 백지가 되지 않는다. */
  :global(html.js) [data-line] {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(html.js) [data-line].on {
    opacity: 1;
    transform: none;
    transition: opacity .85s cubic-bezier(.22,1,.36,1) var(--d), transform .85s cubic-bezier(.22,1,.36,1) var(--d);
  }

  @media (max-width: 720px) {
    .hero { padding: calc(62px + 4vh) 0 9vh; min-height: 92svh; }
    h1 { margin-bottom: 24px; }
    .cue { margin-top: 34px; gap: 12px; }
    .hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-line] { opacity: 1; transform: none; }
    .go svg { animation: none; }
  }
</style>

<script>
  const lines = Array.from(document.querySelectorAll<HTMLElement>('.hero [data-line]'));
  // 살아났다고 알린다 — 없으면 2.5초 뒤 failsafe 가 강제로 다 보여준다
  document.documentElement.classList.add('hero-ready');
  // 첫 화면은 스크롤을 기다리지 않는다. 들어오자마자 순서대로 뜬다.
  requestAnimationFrame(() => lines.forEach((el) => el.classList.add('on')));

  // 아래로 갔다가 다시 첫 화면으로 올라오면 처음부터 재생한다.
  const heroEl = document.querySelector('.hero');
  if (heroEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) lines.forEach((el) => el.classList.add('on'));
        else lines.forEach((el) => el.classList.remove('on'));
      });
    }, { threshold: 0.35 });
    io.observe(heroEl);
  }
</script>
