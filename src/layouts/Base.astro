---
import '../styles/tokens.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** og:image 경로 (public 기준). 없으면 기본 스크린샷. */
  ogImage?: string;
  /** 첫 화면처럼 자기 표지·연락 색면을 직접 가진 페이지 — 공통 헤더·푸터를 생략한다. */
  bare?: boolean;
}

const { title, description, ogImage = '/shots/statusline.png', bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://parkgeunmin.pages.dev');
const ogUrl = new URL(ogImage, Astro.site ?? 'https://parkgeunmin.pages.dev');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1f3d36" />

    {/* 3-B 시안이 쓰는 그대로 — 본문 Noto Sans KR, 숫자·라벨 IBM Plex Mono */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    {/*
      백지 방지: 사례 카드의 등장 모션은 요소를 숨겼다가 보여주는 방식이라, 스크립트가
      죽으면 비어 보인다. html.js 가 붙어야만 숨김이 적용되고, 2.5초 뒤에는 강제로 다 보여준다.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        document.documentElement.classList.add('motion-failsafe');
      }, 2500);
    </script>

    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip">본문으로 건너뛰기</a>
    {!bare && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    {!bare && <SiteFooter />}

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--brass);
        color: #1a2622;
        padding: 10px 18px;
        border-radius: 0 0 var(--r-sm) 0;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
